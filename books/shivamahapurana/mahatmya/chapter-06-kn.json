{
  "book": "shivamahapurana",
  "section": "ಮಾಹಾತ್ಮ್ಯ",
  "chapter": 6,
  "title": "ಶಿವಪುರಾಣ ಶ್ರವಣವಿಧಿವರ್ಣನೆ",
  "source": {
    "language": "kn",
    "edition": "User-provided scanned Kannada Shiva Purana",
    "status": "Kannada-script shlokas prepared from the repository Sanskrit text; Kannada meanings to be transcribed from the scanned edition",
    "printedPages": "see scanned Kannada edition",
    "verseRange": "1-65"
  },
  "blocks": [
    {
      "speaker": "ಶೌನಕ ಉವಾಚ",
      "shlokas": [
        {
          "number": 1,
          "lines": [
            "ಸೂತ ಸೂತ ಮಹಾಪ್ರಾಜ್ಞ ವ್ಯಾಸಶಿಷ್ಯ ನಮೋಽಸ್ತು ತೇ।",
            "ಧನ್ಯಸ್ತ್ವಂ ಶೈವವರ್ಯೋಽಸಿ ವರ್ಣನೀಯಮಹದ್ಗುಣಃ॥ ೧॥"
          ]
        },
        {
          "number": 2,
          "lines": [
            "ಶ್ರೀಮಚ್ಛಿವಪುರಾಣಸ್ಯ ಶ್ರವಣಸ್ಯ ವಿಧಿಂ ವದ।",
            "ಯೇನ ಸರ್ವಂ ಲಭೇಚ್ಛ್ರೋತಾ ಸಮ್ಪೂರ್ಣಂ ಫಲಮುತ್ತಮಮ್॥ ೨॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 3,
          "lines": [
            "ಅಥ ತೇ ಸಮ್ಪ್ರವಕ್ಷ್ಯಾಮಿ ಸಮ್ಪೂರ್ಣಫಲಹೇತವೇ।",
            "ವಿಧಿಂ ಶಿವಪುರಾಣಸ್ಯ ಶೌನಕ ಶ್ರವಣೇ ಮುನೇ॥ ೩॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 4,
          "lines": [
            "ದೈವಜ್ಞಂ ಚ ಸಮಾಹೂಯ ಸಂತೋಷ್ಯ ಚ ಜನಾನ್ವಿತಃ।",
            "ಮುಹೂರ್ತಂ ಶೋಧಯೇಚ್ಛುದ್ಧಂ ನಿರ್ವಿಘ್ನೇನ ಸಮಾಪ್ತಯೇ॥ ೪॥"
          ]
        },
        {
          "number": 5,
          "lines": [
            "ವಾರ್ತಾ ಪ್ರೇಷ್ಯಾ ಪ್ರಯತ್ನೇನ ದೇಶೇ ದೇಶೇ ಚ ಸಾ ಶುಭಾ।",
            "ಭವಿಷ್ಯತಿ ಕಥಾ ಶೈವೀ ಆಗಂತವ್ಯಂ ಶುಭಾರ್ಥಿಭಿಃ॥ ೫॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 6,
          "lines": [
            "ದೂರೇ ಹರಿಕಥಾಃ ಕೇಚಿದ್ ದೂರೇ ಶಙ್ಕರಕೀರ್ತನಾಃ।",
            "ಸ್ತ್ರಿಯಃ ಶೂದ್ರಾದಯೋ ಯೇ ಚ ಬೋಧಸ್ತೇಷಾಂ ಭವೇದ್ಯತಃ॥ ೬॥"
          ]
        },
        {
          "number": 7,
          "lines": [
            "ದೇಶೇ ದೇಶೇ ಶಾಮ್ಭವಾ ಯೇ ಕೀರ್ತನಶ್ರವಣೋತ್ಸುಕಾಃ।",
            "ತೇಷಾಮಾನಯನಂ ಕಾರ್ಯಂ ತತ್ಪ್ರಕಾರಾರ್ಥಮಾದರಾತ್॥ ೭॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 8,
          "lines": [
            "ಭವಿಷ್ಯತಿ ಸಮಾಜೋಽತ್ರ ಸಾಧೂನಾಂ ಪರಮೋತ್ಸವಃ।",
            "ಪಾರಾಯಣೇ ಪುರಾಣಸ್ಯ ಶೈವಸ್ಯ ಪರಮಾದ್ಭುತಃ॥ ೮॥"
          ]
        },
        {
          "number": 9,
          "lines": [
            "ಶ್ರೀಮಚ್ಛಿವಪುರಾಣಾಹ್ವರಸಪಾನಾಯ ಚಾದರಾತ್।",
            "ಆಯಾಂತವರಂ ಭವಂತಶ್ಚ ಕೃಪಯಾ ಪ್ರೇಮತತ್ಪರಾಃ॥ ೯॥"
          ]
        },
        {
          "number": 10,
          "lines": [
            "ನಾವಕಾಶೋ ಯದಿ ಪ್ರೇಮ್ಣಾಗಂತವ್ಯಂ ದಿನಮೇಕಕಮ್।",
            "ಸರ್ವಥಾಗಮನಂ ಕಾರ್ಯಂ ದುರ್ಲಭಾ ಚ ಕ್ಷಣಸ್ಥಿತಿಃ॥ ೧೦॥"
          ]
        },
        {
          "number": 11,
          "lines": [
            "ತೇಷಾಮಾಹ್ವಾನಮೇವಂ ಹಿ ಕಾರ್ಯಂ ಸವಿನಯಂ ಮುದಾ।",
            "ಆಗತಾನಾಂ ಚ ತೇಷಾಂ ಹಿ ಸರ್ವಥಾ ಕಾರ್ಯ ಆದರಃ॥ ೧೧॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 12,
          "lines": [
            "ಶಿವಾಲಯೇ ಚ ತೀರ್ಥೇ ವಾ ವನೇ ವಾಪಿ ಗೃಹೇಽಥವಾ।",
            "ಕಾರ್ಯಂ ಶಿವಪುರಾಣಸ್ಯ ಶ್ರವಣಸ್ಥಲಮುತ್ತಮಮ್॥ ೧೨॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 13,
          "lines": [
            "ಕಾರ್ಯಂ ಸಂಶೋಧನಂ ಭೂಮೇರ್ಲೇಪನಂ ಧಾತುಮಣ್ಡನಮ್।",
            "ವಿಚಿತ್ರಾ ರಚನಾ ದಿವ್ಯಾ ಮಹೋತ್ಸವಪುರಸ್ಸರಮ್॥ ೧೩॥"
          ]
        },
        {
          "number": 14,
          "lines": [
            "ಗೃಹೋಪಸ್ಕರಮುದ್ಧೃತ್ಯ ನಿಖಿಲಂ ತದಯೋಗ್ಯಕಮ್।",
            "ಏಕಾಂತೇ ಗೃಹಕೋಣೇ ಚಾದೃಶ್ಯೇ ಯತ್ನಾನ್ನಿವೇಶಯೇತ್॥ ೧೪॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 15,
          "lines": [
            "ಕರ್ತವ್ಯೋ ಮಣ್ಡಪೋಽತ್ಯುಚ್ಚೈಃ ಕದಲೀಸ್ತಮ್ಭಮಣ್ಡಿತಃ।",
            "ಫಲಪುಷ್ಪಾದಿಭಿಸ್ಸಮ್ಯಗ್ವಿಷ್ವಗ್ವೈತಾನರಾಜಿತಃ॥ ೧೫॥"
          ]
        },
        {
          "number": 16,
          "lines": [
            "ಚತುರ್ದಿಕ್ಷು ಧ್ವಜಾರೋಪಸ್ಸಪತಾಕಃ ಸುಶೋಭನಃ।",
            "ಸುಭಕ್ತಿಃ ಸರ್ವಥಾ ಕಾರ್ಯಾ ಸರ್ವಾನಂದವಿಧಾಯಿನೀ॥ ೧೬॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 17,
          "lines": [
            "ಸಙ್ಕಲ್ಪ್ಯಮಾಸನಂ ದಿವ್ಯಂ ಶಙ್ಕರಸ್ಯ ಪರಾತ್ಮನಃ।",
            "ವಕ್ತುಶ್ಚಾಪಿ ತಥಾ ದಿವ್ಯಮಾಸನಂ ಸುಖಸಾಧನಮ್॥ ೧೭॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 18,
          "lines": [
            "ಶ್ರೋತೄಣಾಂ ಕಲ್ಪನೀಯಾನಿ ಸುಸ್ಥಲಾನಿ ಯಥಾರ್ಹತಃ।",
            "ಅನ್ಯೇಷಾಂ ಚ ಸ್ಥಲಾನ್ಯೇವ ಸಾಧಾರಣತಯಾ ಮುನೇ॥ ೧೮॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 19,
          "lines": [
            "ವಿವಾಹೇ ಯಾದೃಶಂ ಚಿತ್ತಂ ತಾದೃಶಂ ಕಾರ್ಯಮೇವ ಹಿ।",
            "ಅನ್ಯಾ ಚಿಂತಾ ವಿನಿರ್ವಾರ್ಯಾ ಸರ್ವಾ ಶೌನಕ ಲೌಕಿಕೀ॥ ೧೯॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 20,
          "lines": [
            "ಉದಙ್ಮುಖೋ ಭವೇದ್ವಕ್ತಾ ಶ್ರೋತಾ ಪ್ರಾಗ್ವದನಸ್ತಥಾ।",
            "ವ್ಯುತ್ಕ್ರಮಃ ಪಾದಯೋರ್ಜ್ಞೇಯೋ ವಿರೋಧೋ ನಾಸ್ತಿ ಕಶ್ಚನ॥ ೨೦॥"
          ]
        },
        {
          "number": 21,
          "lines": [
            "ಅಥವಾ ಪೂರ್ವದಿಗ್ಜ್ಞೇಯಾ ಪೂಜ್ಯಪೂಜಕಮಧ್ಯತಃ।",
            "ಅಥವಾ ಸಮ್ಮುಖೇ ವಕ್ತುಃ ಶ್ರೋತೄಣಾಾಮಾನನಂ ಸ್ಮೃತಮ್॥ ೨೧॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 22,
          "lines": [
            "ವ್ಯಾಸಾಸನಸಮಾರೂಢೋ ಯದಾ ಪೌರಾಣಿಕೋ ದ್ವಿಜಃ।",
            "ಅಸಮಾಪ್ತೌ ಪ್ರಸಙ್ಗಸ್ಯ ನಮಸ್ಕುರ್ಯಾನ್ನ ಕಸ್ಯಚಿತ್॥ ೨೨॥"
          ]
        },
        {
          "number": 23,
          "lines": [
            "ಬಾಲೋ ಯುವಾಥ ವೃದ್ಧೋ ವಾ ದರಿದ್ರೋ ವಾಪಿ ದುರ್ಬಲಃ।",
            "ಪುರಾಣಜ್ಞಃ ಸದಾ ವಂದ್ಯಃ ಪೂಜ್ಯಶ್ಚ ಸುಕೃತಾರ್ಥಿಭಿಃ॥ ೨೩॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 24,
          "lines": [
            "ನೀಚಬುದ್ಧಿಂ ನ ಕುರ್ವೀತ ಪುರಾಣಜ್ಞೇ ಕದಾಚನ।",
            "ಯಸ್ಯ ವಕ್ತ್ರೋದ್ಗತಾ ವಾಣೀ ಕಾಮಧೇನುಃ ಶರೀರಿಣಾಮ್॥ ೨೪॥"
          ]
        },
        {
          "number": 25,
          "lines": [
            "ಗುರವಃ ಸಂತಿ ಬಹವೋ ಜನ್ಮಾತೋ ಗುಣತಶ್ಚ ವೈ।",
            "ಪರೋ ಗುರುಃ ಪುರಾಣಜ್ಞಸ್ತೇಷಾಂ ಮಧ್ಯೇ ವಿಶೇಷತಃ॥ ೨೫॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 26,
          "lines": [
            "ಭವಕೋಟಿಸಹಸ್ರೇಷು ಭೂತ್ವಾ ಭೂತ್ವಾವಸೀದತಾಮ್।",
            "ಯೋ ದದಾತಿ ಪರಾಂ ಮುಕ್ತಿಂ ಕೋಽನ್ಯಸ್ತಸ್ಮಾತ್ ಪರೋ ಗುರುಃ॥ ೨೬॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 27,
          "lines": [
            "ಪುರಾಣಜ್ಞಃ ಶುಚಿರ್ದಕ್ಷಃ ಶಾಂತೋ ವಿಜಿತಮತ್ಸರಃ।",
            "ಸಾಧುಃ ಕಾರುಣ್ಯವಾನ್ ವಾಗ್ಮೀ ವದೇತ್ ಪುಣ್ಯಕಥಾಮಿಮಾಮ್॥ ೨೭॥"
          ]
        },
        {
          "number": 28,
          "lines": [
            "ಆಸೂರ್ಯೋದಯಮಾರಭ್ಯ ಸಾರ್ಧತ್ರಿಪ್ರಹರಾಂತಕಮ್।",
            "ಕಥಾ ಶಿವಪುರಾಣಸ್ಯ ವಾಚ್ಯಾ ಸಮ್ಯಕ್ ಸುಧೀಮತಾ॥ ೨೮॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 29,
          "lines": [
            "ಯೇ ಧೂರ್ತಾ ಯೇ ಚ ದುರ್ವೃತ್ತಾ ಯೇ ಚಾನ್ಯೇ ವಿಜಿಗೀಷವಃ।",
            "ತೇಷಾಂ ಕುಟಿಲವೃತ್ತೀನಾಮಗ್ರೇ ನೈವ ವದೇತ್ ಕಥಾಮ್॥ ೨೯॥"
          ]
        },
        {
          "number": 30,
          "lines": [
            "ನ ದುರ್ಜನಸಮಾಕೀರ್ಣೇ ನ ತು ದಸ್ಯುಸಮಾವೃತೇ।",
            "ದೇಶೇ ನ ಧೂರ್ತಸದನೇ ವದೇತ್ ಪುಣ್ಯಕಥಾಮಿಮಾಮ್॥ ೩೦॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 31,
          "lines": [
            "ಕಥಾವಿರಾಮಃ ಕರ್ತವ್ಯೋ ಮಧ್ಯಾಹ್ನೇ ಹಿ ಮುಹೂರ್ತಕಮ್।",
            "ಮಲಮೂತ್ರೋತ್ಸರ್ಜನಾರ್ಥಂ ತತ್ಕಥಾಕೀರ್ತನಾನ್ನರೈಃ॥ ೩೧॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 32,
          "lines": [
            "ವಕ್ತ್ರಾ ಕ್ಷೌರಂ ಹಿ ಸಙ್ಕಾರ್ಯಂ ದಿನಾದರ್ವಾಗ್ವ್ರತಾಪ್ತಯೇ।",
            "ಕಾರ್ಯಂ ಸಂಕ್ಷೇಪತೋ ನಿತ್ಯಕರ್ಮ ಸರ್ವಂ ಪ್ರಯತ್ನತಃ॥ ೩೨॥"
          ]
        },
        {
          "number": 33,
          "lines": [
            "ವಕ್ತುಃ ಪಾರ್ಶ್ವೇ ಸಹಾಯಾರ್ಥಮನ್ಯಃ ಸ್ಥಾಪ್ಯಸ್ತಥಾವಿಧಃ।",
            "ಪಣ್ಡಿತಃ ಸಂಶಯಚ್ಛೇತ್ತಾ ಲೋಕಬೋಧನತತ್ಪರಃ॥ ೩೩॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 34,
          "lines": [
            "ಕಥಾವಿಘ್ನವಿನಾಶಾರ್ಥಂ ಗಣನಾಂಥಂ ಪ್ರಪೂಜಯೇತ್।",
            "ಕಥಾಧೀಶಂ ಶಿವಂ ಭಕ್ತ್ಯಾ ಪುಸ್ತಕಂ ಚ ವಿಶೇಷತಃ॥ ೩೪॥"
          ]
        },
        {
          "number": 35,
          "lines": [
            "ಕಥಾಂ ಶಿವಪುರಾಣಸ್ಯ ಶೃಣುಯಾದಾದರಾತ್ಸುಧೀಃ।",
            "ಶ್ರೋತಾ ಸುವಿಧಿನಾ ಶುದ್ಧಃ ಶುದ್ಧಚಿತ್ತಃ ಪ್ರಸನ್ನಧೀಃ॥ ೩೫॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 36,
          "lines": [
            "ಅನೇಕಕರ್ಮವಿಭ್ರಾಂತಃ ಕಾಮಾದಿಷಡ್ವಿಕಾರವಾನ್।",
            "ಸ್ತ್ರೈಣಃ ಪಾಖಣ್ಡವಾದೀ ಚ ವಕ್ತಾ ಶ್ರೋತಾ ನ ಪುಣ್ಯಭಾಕ್॥ ೩೬॥"
          ]
        },
        {
          "number": 37,
          "lines": [
            "ಲೋಕಚಿಂತಾಂ ಧನಾಗಾರಪುತ್ರಚಿಂತಾಂ ವ್ಯುದಸ್ಯ ಚ।",
            "ಕಥಾಚಿತ್ತಃ ಶುದ್ಧಮತಿಃ ಸ ಲಭೇತ್ ಫಲಮುತ್ತಮಮ್॥ ೩೭॥"
          ]
        },
        {
          "number": 38,
          "lines": [
