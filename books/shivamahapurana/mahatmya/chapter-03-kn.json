{
  "book": "shivamahapurana",
  "section": "ಮಾಹಾತ್ಮ್ಯ",
  "chapter": 3,
  "title": "ಚಂಚುಲಾ ವೈರಾಗ್ಯವರ್ಣನೆ",
  "source": {
    "language": "kn",
    "edition": "User-provided scanned Kannada Shiva Purana",
    "status": "Kannada-script shlokas prepared from the repository Sanskrit text; Kannada meanings to be transcribed from the scanned edition",
    "printedPages": "see scanned Kannada edition",
    "verseRange": "1-57"
  },
  "blocks": [
    {
      "speaker": "ಶೌನಕ ಉವಾಚ",
      "shlokas": [
        {
          "number": 1,
          "lines": [
            "ಸೂತ ಸೂತ ಮಹಾಭಾಗ ಸರ್ವಜ್ಞೋಽಸಿ ಮಹಾಮತೇ।",
            "ತ್ವತ್ಪ್ರಸಾದಾತ್ ಕೃತಾರ್ಥೋಽಹಂ ಕೃತಾರ್ಥೋಽಹಂ ಪುನಃ ಪುನಃ॥"
          ]
        },
        {
          "number": 2,
          "lines": [
            "ಇತಿಹಾಸಮಿಮಂ ಶ್ರುತ್ವಾ ಮನೋ ಮೇಽತೀವ ಮೋದತೇ।",
            "ಅನ್ಯಾಮಪಿ ಕಥಾಂ ಶಮ್ಭೋರ್ವದ ಪ್ರೇಮವಿವರ್ಧಿನೀಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಶೌನಕ ಉವಾಚ",
      "shlokas": [
        {
          "number": 3,
          "lines": [
            "ನಾಮೃತಂ ಪಿಬತಾಂ ಲೋಕೇ ಮುಕ್ತಿ: ಕ್ವಾಪಿ ಸಭಾಜ್ಯತೇ।",
            "ಶಮ್ಭೋಃ ಕಥಾಸುಧಾಪಾನಂ ಪ್ರತ್ಯಕ್ಷಂ ಮುಕ್ತಿದಾಯಕಮ್॥"
          ]
        },
        {
          "number": 4,
          "lines": [
            "ಧನ್ಯಾ ಧನ್ಯಾ ಕಥಾ ಶಮ್ಭೋಸ್ತ್ವಂ ಧನ್ಯೋ ಧನ್ಯ ಏವ ಚ।",
            "ಯದಾಕರ್ಣನಮಾತ್ರೇಣ ಶಿವಲೋಕಂ ವ್ರಜೇನ್ನರಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 5,
          "lines": [
            "ಶೃಣು ಶೌನಕ ವಕ್ಷ್ಯಾಮಿ ತ್ವದಗ್ರೇ ಗುಹ್ಯಮಪ್ಯುತ।",
            "ಯತಸ್ತ್ವಂ ಶಿವಭಕ್ತಾನಾಮಗ್ರಣೀರ್ವೇದವಿತ್ತಮಃ॥"
          ]
        },
        {
          "number": 6,
          "lines": [
            "ಸಮುದ್ರನಿಕಟೇ ದೇಶೇ ಗ್ರಾಮೋ ಬಾಷ್ಕಲಸಂಜ್ಞಕಃ।",
            "ವಸಂತಿ ಯತ್ರ ಪಾಪಿಷ್ಠಾ ವೇದಧರ್ಮೋಜ್ಝಿತಾ ಜನಾಃ॥"
          ]
        },
        {
          "number": 7,
          "lines": [
            "ದುಷ್ಟಾ ದುರ್ವಿಷಯಾತ್ಮಾನೋ ನಿದೇವಾ ಜಿಹ್ವವೃತ್ತಯಃ।",
            "ಕೃಷೀವಲಾಃ ಶಸ್ತ್ರಧರಾಃ ಪರಸ್ತ್ರೀಭೋಗಿನಃ ಖಲಾಃ॥"
          ]
        },
        {
          "number": 8,
          "lines": [
            "ಜ್ಞಾನವೈರಾಗ್ಯಸದ್ಧರ್ಮಂ ನ ಜಾನಂತಿ ಪರಂ ಹಿ ತೇ।",
            "ಕುಕಥಾಶ್ರವಣಾಢ್ಯೇಷು ನಿರತಾಃ ಪಶುಬುದ್ಧಯಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 9,
          "lines": [
            "ಅನ್ಯೇ ವರ್ಣಾಶ್ಚ ಕುಧಿಯಃ ಸ್ವಧರ್ಮವಿಮುಖಾಃ ಖಲಾಃ।",
            "ಕುಕರ್ಮನಿರತಾ ನಿತ್ಯಂ ಸದಾ ವಿಷಯಿಣಶ್ಚ ತೇ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 10,
          "lines": [
            "ಸ್ತ್ರಿಯಃ ಸರ್ವಾಶ್ಚ ಕುಟಿಲಾಃ ಸ್ವೈರಿಣ್ಯಃ ಪಾಪಲಾಲಸಾಃ।",
            "ಕುಧಿಯೋ ವ್ಯಭಿಚಾರಿಣ್ಯಃ ಸದ್ವೃತ್ತಾಚಾರವರ್ಜಿತಾಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 11,
          "lines": [
            "ಏವಂ ಕುಜನಸಂವಾಸೇ ಗ್ರಾಮೇ ಬಾಷ್ಕಲಸಂಜ್ಞಿತೇ।",
            "ತತ್ರೈಕೋ ಬಿಂದುಗೋ ನಾಮ ವಿಪ್ರ ಆಸೀನ್ಮಹಾಧಮಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 12,
          "lines": [
            "ಸ ದುರಾತ್ಮಾ ಮಹಾಪಾಪೀ ಸುದಾರೋಽಪಿ ಕುಮಾರ್ಗಗಃ।",
            "ವೇಶ್ಯಾಪತಿರ್ಬಭೂವಾಥ ಕಾಮಾಕುಲಿತಮಾನಸಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 13,
          "lines": [
            "ಸ್ವಪತ್ನೀಂ ಚಂಚುಲಾಂ ನಾಮ ಹಿತ್ವಾ ನಿತ್ಯಂ ಸುಧರ್ಮಿಣೀಮ್।",
            "ರೇಮೇ ಸ ವೇಶ್ಯಯಾ ದುಷ್ಟಃ ಸ್ಮರಬಾಣಪ್ರಪೀಡಿತಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 14,
          "lines": [
            "ಏವಂ ಕಾಲೋ ವ್ಯತೀಯಾಯ ಮಹಾಂಸ್ತಸ್ಯ ಕುಕರ್ಮಿಣಃ।",
            "ಸಾ ಸ್ವಧರ್ಮಭಯಾತ್ ಕ್ಲೇಶಾತ್ ಸ್ಮರಾರ್ತಾಪಿ ಚ ಚಂಚುಲಾ॥"
          ]
        },
        {
          "number": 15,
          "lines": [
            "ಅಥ ತಸ್ಯಾಙ್ಗನಾ ಸಾಪಿ ಪ್ರರೂಢನವಯೌವನಾ।",
            "ಅವಿಷಹ್ಯಸ್ಮರಾವೇಶಾ ಸ್ವಧರ್ಮಾದ್ವಿರರಾಮ ಹ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 16,
          "lines": [
            "ಜಾರೈಃ ಸಙ್ಗತಾ ರಾತ್ರೌ ರೇಮೇ ಪಾಪೇನ ಗುಪ್ತತಃ।",
            "ಪತಿದೃಷ್ಟಿಂ ವಂಚಯಿತ್ವಾ ಭ್ರಷ್ಟಸತ್ತ್ವಾ ಕುಮಾರ್ಗಗಾ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 17,
          "lines": [
            "ಕದಾಚಿತ್ತಾಂ ದುರಾಚಾರಾಂ ಸ್ವಪತ್ನೀಂ ಚಂಚುಲಾಂ ಮುನೇ।",
            "ಜಾರೈಃ ಸಙ್ಗತಾಂ ರಾತ್ರೌ ದದರ್ಶ ಸ್ಮರವಿಹ್ವಲಾಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 18,
          "lines": [
            "ದೃಷ್ಟ್ವಾ ತಾಂ ದೂಷಿತಾಂ ಪತ್ನೀಂ ಕುಕರ್ಮಾಸಕ್ತಮಾನಸಾಮ್।",
            "ಜಾರೈಃ ಸಙ್ಗತಾಂ ರಾತ್ರೌ ಕ್ರೋಧಾದ್ ದುದ್ರಾವ ವೇಗತಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 19,
          "lines": [
            "ತಮಾಗತಂ ಗೃಹೇ ದುಷ್ಟಮಾಜ್ಞಾಯ ಬಿಂದುಗಂ ಖಲಃ।",
            "ಪಲಾಯಿತೋ ದ್ರುತಂ ಜಾರೋ ವೇಗತಶ್ಛದ್ಮವಾನ್ ಸ ವೈ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 20,
          "lines": [
            "ಅಥ ಸ ಬಿಂದುಗಃ ಪತ್ನೀಂ ಗೃಹೀತ್ವಾ ಸುದುರಾಶಯಃ।",
            "ಮುಷ್ಟಿಬಂಧೇನ ಸಂತರ್ಜ್ಯ ಪುನಃ ಪುನರತಾಡಯತ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 21,
          "lines": [
            "ಸಾ ನಾರೀ ತಾಡಿತಾ ಭರ್ತ್ರಾ ಚಂಚುಲಾ ಸ್ವೈರಿಣೀ ಖಲಾ।",
            "ಕುಪಿತಾ ನಿರ್ಭಯಾ ಪ್ರಾಹ ಸ್ವಪತಿಂ ಬಿಂದುಗಂ ಖಲಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಚಂಚುಲಾ ಉವಾಚ",
      "shlokas": [
        {
          "number": 22,
          "lines": [
            "ಭವಾನ್ ಪ್ರತಿದಿನಂ ಕಾಮಂ ರಮತೇ ವೇಶ್ಯಯಾ ಕುಧೀಃ।",
            "ಮಾಂ ವಿಹಾಯ ಸ್ವಪತ್ನೀಂ ಚ ಯುವತೀಂ ಪತಿಸೇವಿನೀಮ್॥"
          ]
        },
        {
          "number": 23,
          "lines": [
            "ರೂಪವತ್ಯಾ ಯುವತ್ಯಾಶ್ಚ ಕಾಮಾಕುಲಿತಚೇತಸಃ।",
            "ವಿನಾ ಪತಿಸಂಸರ್ಗಂ ಕಾ ಗತಿರ್ಮೇ ಭವಾನ್ ವದೇತ್॥"
          ]
        },
        {
          "number": 24,
          "lines": [
            "ಅಹಂ ಮಹಾರೂಪವತೀ ನವಯೌವನವಿಹ್ವಲಾ।",
            "ಕಥಂ ಸಹೇ ಕಾಮದುಃಖಂ ತವ ಸಙ್ಗಂ ವಿನಾರ್ತಧೀಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 25,
          "lines": [
            "ಇತ್ಯುಕ್ತಃ ಸ ತಯಾ ಮೂರ್ಖೋ ಮೂಢಧೀರ್ಬ್ರಾಹ್ಮಣಾಧಮಃ।",
            "ಪ್ರೋವಾಚ ಬಿಂದುಗಃ ಪಾಪೀ ಸ್ವಧರ್ಮವಿಮುಖಃ ಖಲಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಬಿಂದುಗ ಉವಾಚ",
      "shlokas": [
        {
          "number": 26,
          "lines": [
            "ಸತ್ಯಮೇತತ್ತ್ವಯೋಕ್ತಂ ಹಿ ಕಾಮವ್ಯಾಕುಲಚೇತಸಾ।",
            "ಹಿತಂ ವಕ್ಷ್ಯಾಮಿ ತಸ್ಮಾತ್ತೇ ಶೃಣು ಕಾಂತೇ ಭಯಂ ತ್ಯಜ॥"
          ]
        },
        {
          "number": 27,
          "lines": [
            "ಜಾರೈರ್ವಿಹರ ನಿತ್ಯಂ ತ್ವಂ ಚೇತಸಾ ನಿರ್ಭಯೇನ ವೈ।",
            "ಧನಮಾಕರ್ಷ ತೇಭ್ಯೋ ಹಿ ದತ್ತ್ವಾ ತೇಭ್ಯಃ ಪರಾಂ ರತಿಮ್॥"
          ]
        },
        {
          "number": 28,
          "lines": [
            "ತದ್ಧನಂ ದೇಹಿ ಸರ್ವಂ ಮೇ ವೇಶ್ಯಾಽಸಕ್ತಚೇತಸಃ।",
            "ಮಹತ್ಸ್ವಾರ್ಥಂ ಭವೇನ್ನೂನಂ ತವಾಪಿ ಚ ಮಮಾಪಿ ಚ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 29,
          "lines": [
            "ಇತಿ ಭರ್ತೃವಚಃ ಶ್ರುತ್ವಾ ಚಂಚುಲಾ ತದ್ವಧೂಶ್ಚ ಸಾ।",
            "ತಥೇತಿ ಭರ್ತೃವಚನಂ ಪ್ರತಿಜಗ್ರಾಹ ಹೃಷ್ಟಧೀಃ॥"
          ]
        },
        {
          "number": 30,
          "lines": [
            "ಕೃತ್ವೈವಂ ಸಮಯಂ ತೌ ವೈ ದಮ್ಪತೀ ದುಷ್ಟಮಾನಸೌ।",
            "ಕುಕರ್ಮನಿರತೌ ಜಾತೌ ನಿರ್ಭಯೇನ ಕುಚೇತಸಾ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 31,
          "lines": [
            "ಏವಂ ತಯೋಸ್ತು ದಮ್ಪತ್ಯೋರ್ದುರಾಚಾರಪ್ರವೃತ್ತಯೋಃ।",
            "ಮಹಾನ್ ಕಾಲೋ ವ್ಯತೀಯಾಯ ನಿಷ್ಫಲೋ ಮೂಢಚೇತಸೋಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 32,
          "lines": [
            "ಅಥ ವಿಪ್ರಃ ಸ ಕುಮತಿರ್ಬಿಂದುಗೋ ವೃಷಲೀಪತಿಃ।",
            "ಕಾಲೇನ ನಿಧನಂ ಪ್ರಾಪ್ತೋ ಜಗಾಮ ನರಕಂ ಖಲಃ॥"
          ]
        },
        {
          "number": 33,
          "lines": [
            "ಭುಕ್ತ್ವಾ ನರಕದುಃಖಾನಿ ಬಹ್ವಹಾನಿ ಸ ಮೂಢಧೀಃ।",
            "ವಿಂಧ್ಯೇಽಭವತ್ ಪಿಶಾಚೋ ಹಿ ಗಿರೌ ಪಾಪೀ ಭಯಙ್ಕರಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 34,
          "lines": [
            "ಮೃತೇ ಭರ್ತರಿ ತಸ್ಮಿಂಸ್ತು ದುರಾಚಾರಿಣಿ ಬಿಂದುಗೇ।",
            "ಉವಾಸ ಸ್ವಗೃಹೇ ಪುತ್ರೈಶ್ಚಿರಕಾಲಂ ವಿಮೂಢಧೀಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 35,
          "lines": [
            "ಏವಂ ವಿಹರತೀ ಜಾರೈಃ ಸಾ ನಾರೀ ಚಂಚುಲಾಹ್ವಯಾ।",
            "ಆಸೀತ್ ಕಾಮರತಾ ಪ್ರೀತಾ ಕಿಂಚಿದುತ್ಕ್ರಾಂತಯೌವನಾ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 36,
          "lines": [
            "ಏಕದಾ ದೈವಯೋಗೇನ ಸಮ್ಪ್ರಾಪ್ತೇ ಪುಣ್ಯಪರ್ವಣಿ।",
            "ಸಾ ನಾರೀ ಬಂಧುಭಿಃ ಸಾರ್ಧಂ ಗೋಕರ್ಣಕ್ಷೇತ್ರಮಾಯಯೌ॥"
          ]
        },
        {
          "number": 37,
          "lines": [
            "ಪ್ರಸಙ್ಗಾತ್ ಸಾ ತದಾ ಗತ್ವಾ ಕಸ್ಮಿಂಶ್ಚಿತ್ ತೀರ್ಥಪಾಥಸಿ।",
            "ಸಸ್ನೌ ಸಾಮಾನ್ಯತೋ ಯತ್ರ ತತ್ರ ಬಭ್ರಾಮ ಬಂಧುಭಿಃ॥"
          ]
        },
        {
          "number": 38,
          "lines": [
            "ದೇವಾಲಯೇಽಥ ಕಸ್ಮಿಂಶ್ಚಿದ್ ದೈವಜ್ಞಮುಖತಃ ಶುಭಾಮ್।",
            "ಶುಶ್ರಾವ ಸತ್ಕಥಾಂ ಶಮ್ಭೋಃ ಪುಣ್ಯಾಂ ಪೌರಾಣಿಕೀಂ ಚ ಸಾ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 39,
          "lines": [
            "ಯೋಷಿತಾಂ ಜಾರಸಕ್ತಾನಾಂ ನರಕೇ ಯಮಕಿಙ್ಕರಾಃ।",
            "ಸಂತಪ್ತಲೋಹಪರಿಘಂ ಕ್ಷಿಪಂತಿ ಸ್ಮರಮಂದಿರೇ॥"
          ]
        },
        {
          "number": 40,
          "lines": [
            "ಇತಿ ಪೌರಾಣಿಕೋಕ್ತಾಂ ಶ್ರುತ್ವಾ ವೈರಾಗ್ಯವರ್ಧಿನೀಮ್।",
            "ಕಥಾಮಾಸೀದ್ಭಯೋದ್ವಿಗ್ನಾ ಚಕಮ್ಪೇ ತತ್ರ ಸಾ ಚ ವೈ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 41,
          "lines": [
            "ಕಥಾ ಸಮಾಪ್ತೌ ಸಾ ನಾರೀ ನಿರ್ಗತೇಷು ಜನೇಷು ಚ।",
            "ಭೀತಾ ರಹಸಿ ತಂ ಪ್ರಾಹ ಶೈವಂ ಸಂವಾಚಕಂ ದ್ವಿಜಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಚಂಚುಲಾ ಉವಾಚ",
      "shlokas": [
        {
          "number": 42,
          "lines": [
            "ಬ್ರಹ್ಮನ್ ತ್ವಂ ಶ್ರುತಸದ್ವೃತ್ತಮಜಾನಂತ್ಯಾ ಸ್ವಧರ್ಮಕಮ್।",
            "ಶ್ರುತ್ವಾ ಮಾಮುದ್ಧರ ಸ್ವಾಮಿನ್ ಕೃಪಾಂ ಕೃತ್ವಾತುಲಾಮಪಿ॥"
          ]
        },
        {
          "number": 43,
          "lines": [
            "ಚರಿತಂ ಸುಲ್ಬಣಂ ಪಾಪಂ ಮಯಾ ಮೂಢಧಿಯಾ ಪ್ರಭೋ।",
            "ನೀತಂ ಪೌಶ್ಚಲ್ಯತಃ ಸರ್ವಂ ಯೌವನಂ ಮದನಾಂಧಯಾ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಚಂಚುಲಾ ಉವಾಚ",
      "shlokas": [
        {
          "number": 44,
          "lines": [
            "ಶ್ರುತ್ವೇದಂ ವಚನಂ ತೇಽದ್ಯ ವೈರಾಗ್ಯರಸಜುಮ್ಭಿತಮ್।",
            "ಜಾತಾ ಮಹಾಭಯಾ ಸಾಹಂ ಸಕಮ್ಪಾತ್ತವಿಯೋಗಿಕಾ॥"
          ]
        },
        {
          "number": 45,
          "lines": [
            "ಧಿಕ್ ಮಾಂ ಮೂಢಧಿಯಂ ಪಾಪಾಂ ಕಾಮಮೋಹಿತಚೇತಸಮ್।",
            "ನಿಂದ್ಯಾಂ ದುರ್ವಿಷಯಾಸಕ್ತಾಂ ವಿಮುಖೀಂ ಹಿ ಸ್ವಧರ್ಮತಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಚಂಚುಲಾ ಉವಾಚ",
      "shlokas": [
        {
          "number": 46,
          "lines": [
            "ಯದಲ್ಪಸ್ಯ ಸುಖಸ್ಯಾರ್ಥೇ ಸ್ವಕಾರ್ಯಸ್ಯ ವಿನಾಶಿನಮ್।",
            "ಮಹಾಪಾಪಂ ಕೃತಂ ಘೋರಮಜಾನಂತ್ಯಾತಿಕಷ್ಟದಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಚಂಚುಲಾ ಉವಾಚ",
      "shlokas": [
        {
          "number": 47,
          "lines": [
            "ಯಾಸ್ಯಾಮಿ ದುರ್ಗತಿಂ ಕಾಂ ಕಾಂ ಘೋರಾಂ ಹಾ ಕಷ್ಟದಾಯಿನೀಮ್।",
            "ಕೋ ಜ್ಞೋ ಯಾಸ್ಯತಿ ಮಾಂ ತತ್ರ ಕುಮಾರ್ಗರತಮಾನಸಾಮ್॥"
          ]
        },
        {
          "number": 48,
          "lines": [
            "ಮರಣೇ ಯಮದೂತಾಂಸ್ತಾನ್ ಕಥಂ ದ್ರಕ್ಷ್ಯೇ ಭಯಙ್ಕರಾನ್।",
            "ಕಥಂ ಪಾಶೈರ್ಬಲಾತ್ ಕಣ್ಠೇ ಬಧ್ಯಮಾನಾ ಧೃತಿಂ ಲಭೇ॥"
          ]
        },
        {
          "number": 49,
          "lines": [
            "ಕಥಂ ಸಹಿಷ್ಯೇ ನರಕೇ ಖಣ್ಡಶೋ ದೇಹಕೃಂತನಮ್।",
            "ಯಾತನಾಂ ತತ್ರ ಮಹತೀಂ ದುಃಖದಾಂ ಚ ವಿಶೇಷತಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಚಂಚುಲಾ ಉವಾಚ",
      "shlokas": [
        {
          "number": 50,
          "lines": [
            "ದಿವಾ ಚೇಷ್ಟಾಮಿಂದ್ರಿಯಾಣಾಂ ಕಥಂ ಪ್ರಾಪ್ಸ್ಯಾಮಿ ಶೋಚತೀ।",
            "ರಾತ್ರೌ ಕಥಂ ಲಭಿಷ್ಯೇಽಹಂ ನಿದ್ರಾಂ ದುಃಖಪರಿಪ್ಲುತಾ॥"
          ]
        },
        {
          "number": 51,
          "lines": [
            "ಹಾ ಹತಾಸ್ಮಿ ಚ ದಗ್ಧಾಸ್ಮಿ ವಿದೀರ್ಣಹೃದಯಾಸ್ಮಿ ಚ।",
            "ಸರ್ವಥಾಹಂ ವಿನಷ್ಟಾಸ್ಮಿ ಪಾಪಿನೀ ಸರ್ವಥಾಪ್ಯಹಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಚಂಚುಲಾ ಉವಾಚ",
      "shlokas": [
        {
          "number": 52,
          "lines": [
            "ಹಾ ವಿಧೇ ಮಾಂ ಮಹಾಪಾಪೇ ದತ್ತ್ವಾ ದುಶ್ಶೇಮುಷೀಂ ಹಠಾತ್।",
            "ಅಪೈತಿ ಯತ್ ಸ್ವಧರ್ಮಾದ್ವೈ ಸರ್ವಸೌಖ್ಯಕರಾದಹೋ॥"
          ]
        },
        {
          "number": 53,
          "lines": [
            "ಶೂಲಪ್ರೋತಸ್ಯ ಶೈಲಾಗ್ರಾತ್ಪತತಸ್ತುಙ್ಗತೋ ದ್ವಿಜ।",
            "ಯದ್ದುಃಖಂ ದೇಹಿನೋ ಘೋರಂ ತಸ್ಮಾತ್ ಕೋಟಿಗುಣಂ ಮಮ॥"
          ]
        },
        {
          "number": 54,
          "lines": [
            "ಅಶ್ವಮೇಧಶತಂ ಕೃತ್ವಾ ಗಙ್ಗಾಂ ಸ್ನಾತ್ವಾ ಶತಂ ಸಮಾಃ।",
            "ನ ಶುದ್ಧಿರ್ಜಾಯತೇ ಪ್ರಾಯೋ ಮತ್ಪಾಪಸ್ಯ ಗರೀಯಸಃ॥"
          ]
        },
        {
          "number": 55,
          "lines": [
            "ಕಿಂ ಕರೋಮಿ ಕ್ವ ಗಚ್ಛಾಮಿ ಕಂ ವಾ ಶರಣಮಾಶ್ರಯೇ।",
            "ಕಸ್ತ್ರಾಯತೇ ಮಾಂ ಲೋಕೇಽಸ್ಮಿನ್ ಪತಂತೀಂ ನರಕಾರ್ಣವೇ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಚಂಚುಲಾ ಉವಾಚ",
      "shlokas": [
        {
          "number": 56,
          "lines": [
            "ತ್ವಮೇವ ಮೇ ಗುರುರ್ಬ್ರಹ್ಮಂಸ್ತ್ವಂ ಮಾತಾ ತ್ವಂ ಪಿತಾಸಿ ಚ।",
            "ಉದ್ಧರೋದ್ಧರ ಮಾಂ ದೀನಾಂ ತ್ವಾಮೇವ ಶರಣಂ ಗತಾಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 57,
          "lines": [
            "ಇತಿ ಸಂಜಾತನಿರ್ವೇದಾಂ ಪತಿತಾಂ ಚರಣದ್ವಯೇ।",
            "ಉತ್ಥಾಪ್ಯ ಕೃಪಯಾ ಧೀಮಾನ್ ಬಭಾಷೇ ಬ್ರಾಹ್ಮಣಃ ಸ ಹಿ॥"
          ]
        }
      ]
    }
  ]
}
