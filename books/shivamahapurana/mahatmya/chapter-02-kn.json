{
  "book": "shivamahapurana",
  "section": "ಮಾಹಾತ್ಮ್ಯ",
  "chapter": 2,
  "title": "ದೇವರಾಜನ ಮುಕ್ತಿವರ್ಣನೆ",
  "source": {
    "language": "kn",
    "edition": "User-provided scanned Kannada Shiva Purana",
    "status": "Kannada-script shlokas prepared from the repository Sanskrit text; Kannada meanings to be transcribed from the scanned edition",
    "printedPages": "see scanned Kannada edition",
    "verseRange": "1-40"
  },
  "blocks": [
    {
      "speaker": "ಶೌನಕ ಉವಾಚ",
      "shlokas": [
        {
          "number": 1,
          "lines": [
            "ಸೂತ ಸೂತ ಮಹಾಭಾಗ ಧನ್ಯಸ್ತ್ವಂ ಪರಮಾರ್ಥವಿತ್‌ ಪ್ರಭೋ।",
            " ಆಖ್ಯಾಹಿ ಮೇ ಕಥಾಸಾರಂ ಪುರಾಣಾನಾಂ ವಿಶೇಷತಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಶೌನಕ ಉವಾಚ",
      "shlokas": [
        {
          "number": 2,
          "lines": [
            "ಅಘೌಘವಿಧ್ವಂಸಕರೀ ಮನಃಶುದ್ಧಿವಿಧಾಯಿನೀ।",
            " ಶಿವಸಂತೋಷಜನನೀ ಕಥೇಯಂ ನಃ ಶ್ರುತಾದ್ಲುತಾ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಶೌನಕ ಉವಾಚ",
      "shlokas": [
        {
          "number": 3,
          "lines": [
            "ಏತತ್ಕಥಾಸಮಾನಂ ನ ಭುವಿ ಕಿಂಚಿತ್‌ ಪರಾತ್ಪರಮ್‌।",
            " ನಿಶ್ಚಯೇನೇತಿ ವಿಜ್ಞಾತಮಸ್ಮಾಭಿಃ ಕೃಪಯಾ ತವ॥"
          ]
        },
        {
          "number": 4,
          "lines": [
            "ಕೇ ಕೇ ವಿಶುಧ್ಯಂತ್ಯನಯಾ ಕಥಯಾ ಪಾಪಿನಃ ಕಲೌ।",
            " ವದ ತಾನ್‌ ಕೃಪಯಾ ಸೂತ ಕೃತಾರ್ಥ ಭುವನಂ ಕುರು॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 5,
          "lines": [
            "ಯೇ ಮಾನವಾಃ ಪಾಪಕೃತೋ ದುರಾಚಾರರತಾಃ ಖಲಾಃ।",
            " ಕಾಮಾದಿನಿರತಾ ನಿತ್ಯಂ ತೇಽಪಿ ಶುಧ್ಯಂತ್ಯನೇನ ವೈ॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 6,
          "lines": [
            "ಜ್ಞಾನಯಜ್ಞಃ ಪರೋಽಯಂ ವೈ ಭುಕ್ತಿಮುಕ್ತಿಪ್ರದಃ ಸದಾ।",
            " ಶೋಧನಃ ಸರ್ವಪಾಪಾನಾಂ ಶಿವಸಂತೋಷಕಾರಕಃ॥"
          ]
        },
        {
          "number": 7,
          "lines": [
            "ತೃಷ್ಣಾಕುಲಾಃ ಸತ್ಯಹೀನಾಃ ಪಿತೃಮಾತೃವಿದೂಷಕಾಃ।",
            " ದಾಮ್ಭಿಕಾ ಹಿಂಸಕಾ ಯೇ ಚ ತೇಽಪಿ ಶುಧ್ಯಂತ್ಯನೇನ ವೈ॥"
          ]
        },
        {
          "number": 8,
          "lines": [
            "ಸ್ವವರ್ಣಾಶ್ರಮಧರ್ಮೇಭ್ಯೋ ವರ್ಜಿತಾ ಮತ್ಸರಾನ್ವಿತಾಃ।",
            " ಜ್ಞಾನಯಜ್ಞೇನ ತೇಽನೇನ ಸಮ್ಪುನಂತಿ ಕಲಾವಪಿ॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 9,
          "lines": [
            "ಛಲಚ್ಛದ್ಮಕರಾ ಯೇ ಚ ಯೇ ಚ ಕ್ರೂರಾಃ ಸುನಿರ್ದಯಾಃ।",
            " ಜ್ಞಾನಯಜ್ಞೇನ ತೇಽನೇನ ಸಮ್ಪುನಂತಿ ಕಲಾವಪಿ॥"
          ]
        },
        {
          "number": 10,
          "lines": [
            "ಬ್ರಹ್ಮಸ್ವಪುಷ್ಟಾಃ ಸತತಂ ವ್ಯಭಿಚಾರರತಾಶ್ಚ ಯೇ।",
            " ಜ್ಞಾನಯಜ್ಞೇನ ತೇಽನೇನ ಸಮ್ಪುನಂತಿ ಕಲಾವಪಿ॥"
          ]
        },
        {
          "number": 11,
          "lines": [
            "ಸದಾ ಪಾಪರತಾ ಯೇ ಚ ಯೇ ಶಠಾಶ್ಚ ದುರಾಶಯಾಃ।",
            " ಜ್ಞಾನಯಜ್ಞೇನ ತೇಽನೇನ ಸಮ್ಪುನಂತಿ ಕಲಾವಪಿ॥"
          ]
        },
        {
          "number": 12,
          "lines": [
            "ಮಲಿನಾ ದುರ್ಧಿಯೋಽಶಾಂತಾ ದೇವತಾದ್ರವ್ಯಭೋಜಿನಃ।",
            " ಜ್ಞಾನಯಜ್ಞೇನ ತೇಽನೇನ ಸಮ್ಪುನಂತಿ ಕಲಾವಪಿ॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 13,
          "lines": [
            "ಪುರಾಣಸ್ಯಾಸ್ಯ ಪುಣ್ಯಂ ಸನ್ಮಹಾಪಾತಕನಾಶನಮ್‌।",
            " ಭುಕ್ತಿಮುಕ್ತಿಪ್ರದಂ ಚೈವ ಶಿವಸಂತೋಷಹೇತುಕಮ್‌॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 14,
          "lines": [
            "ಅತ್ರೈವೋದಾಹರಂತೀಮಮಿತಿಹಾಸಂ ಪುರಾತನಮ್‌।",
            " ಯಸ್ಯ ಶ್ರವಣಮಾತ್ರೇಣ ಪಾಪಹಾನಿರ್ಭವತ್ಯಲಮ್‌॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 15,
          "lines": [
            "ಆಸೀತ್‌ ಕಿರಾತನಗರೇ ಬ್ರಾಹ್ಮಣೋ ಜ್ಞಾನದುರ್ಬಲಃ।",
            " ದರಿದ್ರೋ ರಸವಿಕ್ರೇತಾ ವೇದಧರ್ಮಪರಾಙ್ಮುಖಃ॥"
          ]
        },
        {
          "number": 16,
          "lines": [
            "ಸಂಧ್ಯಾಸ್ನಾನಪರಿಭ್ರಷ್ಟೋ ವೈಶ್ಯವೃತ್ತಿಪರಾಯಣಃ।",
            " ದೇವರಾಜ ಇತಿ ಖ್ಯಾತೋ ವಿಶ್ವಸ್ತಜನವಂಚಕಃ॥"
          ]
        },
        {
          "number": 17,
          "lines": [
            "ಸ ವಿಪ್ರಾನ್‌ ಕ್ಷತ್ರಿಯಾನ್‌ ವೈಶ್ಯಾನ್‌ ಶೂದ್ರಾಂಶ್ಚಾಪಿ ತಥಾಪರಾನ್‌।",
            " ಹತ್ವಾ ನಾನಾಮಿಷೇಣೈವ ತತ್ತದ್ಧನಮಪಾಹರತ್‌॥"
          ]
        },
        {
          "number": 18,
          "lines": [
            "ಅಧರ್ಮಾದ್‌ ಬಹುವಿತ್ತಾನಿ ಪಶ್ಚಾತ್ತೇನಾರ್ಜಿತಾನಿ ವೈ।",
            " ನ ಧರ್ಮಾಯ ಧನಂ ತಸ್ಯ ಸ್ವಲ್ಪಂಚಾಪೀಹ ಪಾಪಿನಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 19,
          "lines": [
            "ಏಕದಾ ಏಕತಡಾಗೇ ಸ ಸ್ನಾತುಂ ಯಾತೋ ಮಹೀಸುರಃ।",
            " ವೇಶ್ಯಾಂ ಶೋಭಾವತೀಂ ನಾಮ ದೃಷ್ಟ್ವಾ ತತ್ರಾತಿವಿಹ್ವಲಃ॥"
          ]
        },
        {
          "number": 20,
          "lines": [
            "ಸ್ವವಶಂ ಧನಿನಂ ವಿಪ್ರಂ ಜ್ಞಾತ್ವಾ ಹೃಷ್ಟಾಥ ಸುಂದರೀ।",
            " ವಾರ್ತಾಲಾಪೇನ ತಚ್ಚಿತ್ತಂ ಪ್ರೀತಿಮತ್ಸಮಜಾಯತ॥"
          ]
        },
        {
          "number": 21,
          "lines": [
            "ಸ್ತ್ರಿಯಂ ಕರ್ತುಂ ಸ ತಾಂ ಮೇನೇ ಪತಿಂ ಕರ್ತುಂ ಚ ಸಾ ತಥಾ।",
            " ಏವಂ ಕಾಮವಶೌ ಭೂತ್ವಾ ಬಹುಕಾಲಂ ವಿಜಹೃತುಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 22,
          "lines": [
            "ಆಸನೇ ಶಯನೇ ಪಾನೇ ಭೋಜನೇ ಕ್ರೀಡನೇ ತಥಾ।",
            " ದಮ್ಪತೀವ ಸದಾ ದ್ವೌ ತು ವವೃತಾತೇ ಪರಸ್ಪರಮ್‌॥"
          ]
        },
        {
          "number": 23,
          "lines": [
            "ಮಾತ್ರಾ ಪಿತ್ರಾ ತಥಾ ಪಲ್ಯಾ ವಾರಿತೋಽಪಿ ಪುನಃ ಪುನಃ।",
            " ನಾಮನ್ಯತ ವಚಸ್ತೇಷಾಂ ಪಾಪವೃತ್ತಿಪರಾಯಣಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 24,
          "lines": [
            "ಏಕದಾ ಈರ್ಷ್ಯಾವಶಾದ್‌ ರಾತ್ರೌ ಮಾತರಂ ಪಿತರಂ ವಧೂಂ।",
            " ಪ್ರಸುಪ್ತಾನ್‌ ನ್ಯವಧೀದ್‌ ದುಷ್ಟೋ ಧನಂ ತೇಷಾಂ ತಥಾಹರತ್‌॥"
          ]
        },
        {
          "number": 25,
          "lines": [
            "ಆತ್ಮನೀನಂ ಧನಂ ಯಚ್ಚ ಪಿತ್ರಾದೀನಾಂ ತಥಾ ಧನಮ್‌।",
            " ವೇಶ್ಯಾಯೈ ದತ್ತವಾನ್‌ ಸರ್ವಂ ಕಾಮೀ ತದ್ಗತಮಾನಸಃ॥"
          ]
        },
        {
          "number": 26,
          "lines": [
            "ಸೋಽಭಕ್ಷ್ಯಭಕ್ಷಕಃ ಪಾಪೀ ಮದಿರಾಪಾನಲಾಲಸಃ।",
            " ಏಕಪಾತ್ರೇ ಸದಾಭುಞ್ಕ್ತ ಸ ವೇಶ್ಯ್ಯೋ ಬ್ರಾಹ್ಮಣಾಧಮಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 27,
          "lines": [
            "ಕದಾಚಿದ್ದೇವಯೋಗೇನ ಪ್ರತಿಷ್ಠಾನಮುಪಾಗತಃ।",
            " ಶಿವಾಲಯಂ ದದರ್ಶಾಸೌ ತತ್ರ ಸಾಧುಜನಾವೃತಮ್‌॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 28,
          "lines": [
            "ಸ್ಥಿತ್ವಾ ತತ್ರ ಚ ವಿಪ್ರೋಽಸೌ ಜ್ವರೇಣಾತಿಪ್ರಪೀಡಿತಃ।",
            " ಶುಶ್ರಾವ ಸತತಂ ಶೈವೀಂ ಕಥಾಂ ವಿಪ್ರಮುಖೋದ್ಗತಾಮ್‌॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 29,
          "lines": [
            "ದೇವರಾಜಶ್ಚ ಮಾಸಾಂತೇ ಜ್ವರೇಣಾಪೀಡಿತೋ ಮೃತಃ।",
            " ಬದ್ಧೋ ಯಮಭಟೈಃ ಪಾಶೈರ್ನೀತೋ ಯಮಪುರಂ ಬಲಾತ್‌॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 30,
          "lines": [
            "ತಾವಚ್ಛಿವಗಣಾಃ ಶುಶ್ರೂಷ್ಟ್ರಿಶೂಲಾಙ್ಕಿತಪಾಣಯಃ।",
            " ಭಸ್ಮಭಾಸಿತಸರ್ವಾಙ್ಗಾ ರುದ್ರಾಕ್ಷಾಙ್ಕಿತವಿಗ್ರಹಾಃ॥"
          ]
        },
        {
          "number": 31,
          "lines": [
            "ಶಿವಲೋಕಾತ್‌ ಸಮಾಗತ್ಯ ಕ್ರುದ್ಧಾ ಯಮಪುರೀಂ ಯಯುಃ।",
            " ತಾಡಯಿತ್ವಾ ತು ತದ್ದೂತಾಂಸ್ತರ್ಜಯಿತ್ವಾ ಪುನಃ ಪುನಃ॥"
          ]
        },
        {
          "number": 32,
          "lines": [
            "ದೇವರಾಜಂ ಸಮಾಮೋಚ್ಯ ವಿಮಾನೇ ಪರಮಾದ್ಭುತೇ।",
            " ಉಪವೇಶ್ಯ ಯದಾ ದೂತಾಃ ಕೈಲಾಸಂ ಗಂತುಮುತ್ಸುಕಾಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 33,
          "lines": [
            "ತದಾ ಯಮಪುರೀಮಧ್ಯೇ ಮಹಾಕೋಲಾಹಲೋಽಭವತ್‌।",
            " ಧರ್ಮರಾಜಸ್ತು ತಂ ಶ್ರುತ್ವಾ ಸ್ವಾಲಯಾದ್‌ ಬಹಿರಾಗಮತ್‌॥"
          ]
        },
        {
          "number": 34,
          "lines": [
            "ದೃಷ್ಟ್ವಾಥ ಚತುರೋ ದೂತಾನ್‌ ಸಾಕ್ಷಾದ್‌ ರುದ್ರಾನಿವಾಪರಾನ್‌।",
            " ಪೂಜಯಾಮಾಸ ಧರ್ಮಜ್ಞೋ ಧರ್ಮರಾಜೋ ಯಥಾವಿಧಿ॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 35,
          "lines": [
            "ಜ್ಞಾನೇನ ಚಕ್ಷುಷಾ ಸರ್ವವೃತ್ತಾಂತಂ ಜ್ಞಾತವಾನ್‌ ಯಮಃ।",
            " ನ ಭಯಾತ್‌ ಪೃಷ್ಟವಾನ್‌ ಕಿಂಚಿಚ್ಛಮ್ಭೋದೂತಾನ್‌ ಮಹಾತ್ಮನಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 36,
          "lines": [
            "ಪೂಜಿತಾಃ ಪ್ರಾರ್ಥಿತಾಸ್ತೇ ವೈ ಕೈಲಾಸಮಗಮಂಸ್ತದಾ।",
            " ದದುಃ ಶಿವಾಯ ಸಾಮ್ಬಾಯ ತಂ ದಯಾವಾರಿರಾಶಯೇ॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 37,
          "lines": [
            "ಧನ್ಯಾ ಶಿವಪುರಾಣಸ್ಯ ಕಥಾ ಪರಮಪಾವನೀ।",
            " ಯಸ್ಯಾಃ ಶ್ರವಣಮಾತ್ರೇಣ ಪಾಪೀಯಾನಪಿ ಮುಕ್ತಿಭಾಕ್‌॥"
          ]
        },
        {
          "number": 38,
          "lines": [
            "ಸದಾಶಿವಮಹಾಸ್ಥಾನಂ ಪರಂ ಧಾಮ ಪರಂ ಪದಮ್‌।",
            " ಯದಾಹುರ್ವೇದವಿದ್ವಾಂಸಃ ಸರ್ವಲೋಕೋಪರಿ ಸ್ಥಿತಮ್‌॥"
          ]
        },
        {
          "number": 39,
          "lines": [
            "ಬ್ರಾಹ್ಮಣಾಃ ಕ್ಷತ್ರಿಯಾ ವೈಶ್ಯಾಃ ಶೂದ್ರಾ ಅನ್ಯೇಽಪಿ ಪ್ರಾಣಿನಃ।",
            " ಹಿಂಸಿತಾ ಧನಲೋಭೇನ ಬಹವೋ ಯೇನ ಪಾಪಿನಾ॥"
          ]
        },
        {
          "number": 40,
          "lines": [
            "ಮಾತೃಪಿತೃವಧೂಹಂತಾ ವೇಶ್ಯಾಗಾಮೀ ಚ ಮದ್ಯಪಃ।",
            " ದೇವರಾಜೋ ದ್ವಿಜಸ್ತತ್ರ ಗತ್ವಾ ಮುಕ್ತೋಽಭವತ್‌ ಕ್ಷಣಾತ್‌॥"
          ]
        }
      ]
    }
  ]
}
