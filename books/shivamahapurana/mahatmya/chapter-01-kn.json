{
  "book": "shivamahapurana",
  "section": "ಮಾಹಾತ್ಮ್ಯ",
  "chapter": 1,
  "title": "ಶೌನಕ ಮಹರ್ಷಿಗಳ ಪ್ರಶ್ನೆಗಳಿಗೆ ಸೂತರು ಶಿವಮಹಾಪುರಾಣದ ಮಹಿಮೆಯನ್ನು ವಿವರಿಸುವುದು",
  "source": {
    "language": "kn",
    "edition": "User-provided scanned Kannada Shiva Purana",
    "status": "source-transcribed-verified-for-reader; verses 1-11",
    "printedPages": "1-4",
    "verseRange": "1-51"
  },
  "blocks": [
    {
      "speaker": "ಶೌನಕ ಉವಾಚ",
      "shlokas": [
        {
          "number": 1,
          "lines": [
            "ಹೇ ಹೇ ಸೂತ ಮಹಾಪ್ರಾಜ್ಞ ಸರ್ವಸಿದ್ಧಾಂತವಿತ್ ಪ್ರಭೋ।",
            "ಆಖ್ಯಾಹಿ ಮೇ ಕಥಾಸಾರಂ ಪುರಾಣಾನಾಂ ವಿಶೇಷತಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಶೌನಕ ಉವಾಚ",
      "shlokas": [
        {
          "number": 2,
          "lines": [
            "ಸದಾಚಾರಶ್ಚ ಸದ್ಭಕ್ತಿರ್ವಿವೇಕೋ ವರ್ಧತೇ ಕಥಮ್।",
            "ಸ್ವವಿಕಾರನಿರಾಸಶ್ಚ ಸಜ್ಜನೈಃ ಕ್ರಿಯತೇ ಕಥಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಶೌನಕ ಉವಾಚ",
      "shlokas": [
        {
          "number": 3,
          "lines": [
            "ಜೀವಾಶ್ಚಾಸುರತಾಂ ಪ್ರಾಪ್ತಾಃ ಪ್ರಾಯೋ ಘೋರೇ ಕಲಾವಿಹೌ।",
            "ತಸ್ಯ ಸಂಶೋಧನೇ ಕಿಂ ಹಿ ವಿದ್ಯತೇ ಪರಮಾಯನಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಶೌನಕ ಉವಾಚ",
      "shlokas": [
        {
          "number": 4,
          "lines": [
            "ಯದಸ್ತಿ ವಸ್ತು ಪರಮಂ ಶ್ರೇಯಸಾಂ ಶ್ರೇಯ ಉತ್ತಮಮ್।",
            "ಪಾವನಂ ಪಾವನಾನಾಂ ಚ ಸಾಧನಂ ತದ್ವದಾಧುನಾ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಶೌನಕ ಉವಾಚ",
      "shlokas": [
        {
          "number": 5,
          "lines": [
            "ಯೇನ ತತ್ಸಾಧನೇನಾಶು ಶುಧ್ಯತ್ಯಾತ್ಮಾ ವಿಶೇಷತಃ।",
            "ಶಿವಪ್ರಾಪ್ತಿರ್ಭವೇತ್ತಾತ ಸದಾ ನಿರ್ಮಲಚೇತಸಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 6,
          "lines": [
            "ಧನ್ಯಸ್ತ್ವಂ ಮುನಿಶಾರ್ದೂಲ ಶ್ರವಣಪ್ರೀತಿಲಾಲಸಃ।",
            "ಅತೋ ವಿಚಾರ್ಯ ಸುಧಿಯಾ ವಚ್ಮಿ ಶಾಸ್ತ್ರಂ ಮಹೋತ್ತಮಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 7,
          "lines": [
            "ಸರ್ವಸಿದ್ಧಾಂತನಿಷ್ಪನ್ನಂ ಭಕ್ತ್ಯಾದಿಕವಿವರ್ಧನಮ್।",
            "ಶಿವತೋಷಕರಂ ದಿವ್ಯಂ ಶೃಣು ವತ್ಸ ರಸಾಯನಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 8,
          "lines": [
            "ಕಾಲವ್ಯಾಲಮಹಾತ್ರಾಸವಿಧ್ವಂಸಕರಮುತ್ತಮಮ್।",
            "ಶೈವಂ ಪುರಾಣಂ ಪರಮಂ ಶಿವೇನೋಕ್ತಂ ಪುರಾ ಮುನೇ॥"
          ]
        },
        {
          "number": 9,
          "lines": [
            "ಸನತ್ಕುಮಾರಸ್ಯ ಮುನೇರುಪದೇಶಾತ್ ಪರಾದರಾತ್।",
            "ವ್ಯಾಸೇನೋಕ್ತಂ ತು ಸಂಕ್ಷೇಪಾತ್ ಕಲಿಜಾನಾಂ ಹಿತಾಯ ಚ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 10,
          "lines": [
            "ಏತಸ್ಮಾದಪರಂ ಕಿಂಚಿತ್ ಪುರಾಣಾಚ್ಛೈವತೋ ಮುನೇ।",
            "ನ ವಿದ್ಯತೇ ಮನಃಶುದ್ಧ್ಯೈ ಕಲಿಜಾನಾಂ ವಿಶೇಷತಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 11,
          "lines": [
            "ಜನ್ಮಾಂತರೇ ಭವೇತ್ ಪುಣ್ಯಂ ಮಹದ್ಯಸ್ಯ ಸುಧೀಮತಃ।",
            "ತಸ್ಯ ಪ್ರೀತಿರ್ಭವೇತ್ತತ್ರ ಮಹಾಭಾಗ್ಯವತೋ ಮುನೇ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 12,
          "lines": [
            "ಏತಚ್ಛಿವಪುರಾಣಂ ಹಿ ಪರಮಂ ಶಾಸ್ತ್ರಮುತ್ತಮಮ್।",
            "ಶಿವರೂಪಂ ಕ್ಷಿತೌ ಜ್ಞೇಯಂ ಸೇವನೀಯಂ ಚ ಸರ್ವಥಾ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 13,
          "lines": [
            "ಪಠನಾಚ್ಛ್ರವಣಾದಸ್ಯ ಭಕ್ತಿಮಾನ್ನರಸತ್ತಮಃ।",
            "ಸದ್ಯಃ ಶಿವಪದಪ್ರಾಪ್ತಿಂ ಲಭತೇ ಸರ್ವಸಾಧನಾತ್॥"
          ]
        },
        {
          "number": 14,
          "lines": [
            "ತಸ್ಮಾತ್ ಸರ್ವಪ್ರಯತ್ನೇನ ಕಾಙ್ಕ್ಷಿತಂ ಪಠನಂ ನೃಭಿಃ।",
            "ತಥಾಸ್ಯ ಶ್ರವಣಂ ಪ್ರೇಮ್ಣಾ ಸರ್ವಕಾಮಫಲಪ್ರದಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 15,
          "lines": [
            "ಪುರಾಣಶ್ರವಣಾಚ್ಛಮ್ಭೋರ್ನಿಷ್ಪಾಪೋ ಜಾಯತೇ ನರಃ।",
            "ಭುಕ್ತ್ವಾ ಭೋಗಾನ್ ಸುವಿಪುಲಾನ್ ಶಿವಲೋಕಮವಾಪ್ನುಯಾತ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 16,
          "lines": [
            "ರಾಜಸೂಯೇನ ಯತ್ಪುಣ್ಯಮಗ್ನಿಷ್ಟೋಮಶತೇನ ಚ।",
            "ತತ್ ಪುಣ್ಯಂ ಲಭತೇ ಶಮ್ಭೋಃ ಕಥಾಶ್ರವಣಮಾತ್ರತಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 17,
          "lines": [
            "ಯೇ ಶೃಣ್ವಂತಿ ಮುನೇ ಶೈವಂ ಪುರಾಣಂ ಶಾಸ್ತ್ರಮುತ್ತಮಮ್।",
            "ತೇ ಮನುಷ್ಯಾ ನ ಮಂತವ್ಯಾ ರುದ್ರಾ ಏವ ನ ಸಂಶಯಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 18,
          "lines": [
            "ಶೃಣ್ವತಾಂ ತತ್ ಪುರಾಣಂ ಹಿ ತಥಾ ಕೀರ್ತಯತಾಂ ಚ ತತ್।",
            "ಪಾದಾಮ್ಬುಜರಜಾಂಸ್ಯೇವ ತೀರ್ಥಾನಿ ಮುನಯೋ ವಿದುಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 19,
          "lines": [
            "ಗಂತುಂ ನಿಃಶ್ರೇಯಸಂ ಸ್ಥಾನಂ ಯೇಽಭಿವಾಞ್ಛಂತಿ ದೇಹಿನಃ।",
            "ಶೈವಂ ಪುರಾಣಮಮಲಂ ಭಕ್ತ್ಯಾ ಶೃಣ್ವಂತು ತೇ ಸದಾ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 20,
          "lines": [
            "ಸದಾ ಶ್ರೋತುಂ ಯದ್ಯಶಕ್ತೋ ಭವೇತ್ ಸ ಮುನಿಸತ್ತಮ।",
            "ನಿಯತಾತ್ಮಾ ಪ್ರತಿದಿನಂ ಶೃಣುಯಾದ್ವಾ ಮುಹೂರ್ತಕಮ್॥"
          ]
        },
        {
          "number": 21,
          "lines": [
            "ಯದಿ ಪ್ರತಿದಿನಂ ಶ್ರೋತುಮಶಕ್ತೋ ಮಾನವೋ ಭವೇತ್।",
            "ಪುಣ್ಯಮಾಸಾದಿಷು ಮುನೇ ಶೃಣುಯಾಚ್ಛಿವಪುರಾಣಕಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 22,
          "lines": [
            "ಮುಹೂರ್ತಂ ವಾ ತದರ್ಧಂ ವಾ ತದರ್ಧಂ ವಾ ಕ್ಷಣಂ ಚ ವಾ।",
            "ಯೇ ಶೃಣ್ವಂತಿ ಪುರಾಣಂ ತನ್ನ ತೇಷಾಂ ದುರ್ಗತಿರ್ಭವೇತ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 23,
          "lines": [
            "ತತ್ಪುರಾಣಂ ಚ ಶೃಣ್ವಾನಃ ಪುರುಷೋ ಯೋ ಮುನೀಶ್ವರ।",
            "ಸ ನಿಸ್ತರತಿ ಸಂಸಾರಂ ದಗ್ಧ್ವಾ ಕರ್ಮಮಹಾಟವೀಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 24,
          "lines": [
            "ಯತ್ಪುಣ್ಯಂ ಸರ್ವದಾನೇಷು ಸರ್ವಯಜ್ಞೇಷು ವಾ ಮುನೇ।",
            "ಶಮ್ಭೋಃ ಪುರಾಣಶ್ರವಣಾತ್ತತ್ಫಲಂ ನಿಶ್ಚಲಂ ಭವೇತ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 25,
          "lines": [
            "ವಿಶೇಷತಃ ಕಲೌ ಶೈವಪುರಾಣಶ್ರವಣಾದೃತೇ।",
            "ಪರೋ ಧರ್ಮೋ ನ ಪುಂಸಾಂ ಹಿ ಮುಕ್ತಿಸಾಧನಕೃನ್ಮುನೇ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 26,
          "lines": [
            "ಪುರಾಣಶ್ರವಣಂ ಶಮ್ಭೋರ್ನಾಮಸಙ್ಕೀರ್ತನಂ ತಥಾ।",
            "ಕಲ್ಪದ್ರುಮಫಲಂ ಸಮ್ಯಕ್ ಮನುಷ್ಯಾಣಾಂ ನ ಸಂಶಯಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 27,
          "lines": [
            "ಕಲೌ ದುರ್ಮೇಧಸಾಂ ಪುಂಸಾಂ ಧರ್ಮಾಚಾರೋಜ್ಝಿತಾತ್ಮನಾಮ್।",
            "ಹಿತಾಯ ವಿದಧೇ ಶಮ್ಭುಃ ಪುರಾಣಾಖ್ಯಂ ಸುಧಾರಸಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 28,
          "lines": [
            "ಏಕೋಽಜರಾಮರಃ ಸ್ಯಾದ್ವೈ ಪಿಬನ್ನೇವಾಮೃತಂ ಪುಮಾನ್।",
            "ಶಮ್ಭೋಃ ಕಥಾಮೃತಂ ಕುರ್ಯಾತ್ ಕುಲಮೇವಾಜರಾಮರಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 29,
          "lines": [
            "ಸದಾ ಸೇವ್ಯಾ ಸದಾ ಸೇವ್ಯಾ ಸದಾ ಸೇವ್ಯಾ ವಿಶೇಷತಃ।",
            "ಏತಚ್ಛಿವಪುರಾಣಸ್ಯ ಕಥಾ ಪರಮಪಾವನೀ॥"
          ]
        },
        {
          "number": 30,
          "lines": [
            "ಏತಚ್ಛಿವಪುರಾಣಸ್ಯ ಕಥಾಶ್ರವಣಮಾತ್ರತಃ।",
            "ಕಿಂ ಬ್ರವೀಮಿ ಫಲಂ ತಸ್ಯ ಶಿವಶ್ಚಿತ್ತಂ ಸಮಾಶ್ರಯೇತ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 31,
          "lines": [
            "ಚತುರ್ವಿಶತಿಸಾಹಸ್ತ್ರೋ ಗ್ರನ್ಥೋಽಯಂ ಸಪ್ತಸಂಹಿತಃ।",
            "ಭಕ್ತಿತ್ರಿಕಸುಸಮ್ಪೂರ್ಣಃ ಶೃಣುಯಾತ್ತಂ ಪರಾದರಾತ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 32,
          "lines": [
            "ವಿದ್ಯೇಶ್ವರಸಂಹಿತಾದ್ಯಾ ದ್ವಿತೀಯಾ ರುದ್ರಸಂಹಿತಾ।",
            "ತೃತೀಯಾ ಶತರುದ್ರಾಖ್ಯಾ ಕೋಟಿರುದ್ರಾ ಚತುರ್ಥಿಕಾ॥"
          ]
        },
        {
          "number": 33,
          "lines": [
            "ಪಞ್ಚಮ್ಯುಮಾಸಂಹಿತೋಕ್ತಾ ಷಷ್ಠೀ ಕೈಲಾಸಸಂಹಿತಾ।",
            "ಸಪ್ತಮೀ ವಾಯವೀಯಾಖ್ಯಾ ಸಪ್ತೈವಂ ಸಂಹಿತಾ ಇಹ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 34,
          "lines": [
            "ಸಪ್ತಸಂಹಿತಂ ದಿವ್ಯಂ ಪುರಾಣಂ ಶಿವಸಂಜ್ಞಕಮ್।",
            "ವರೀವರ್ತಿ ಬ್ರಹ್ಮತುಲ್ಯಂ ಸರ್ವೋಪರಿ ಗತಿಪ್ರದಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 35,
          "lines": [
            "ಏತಚ್ಛಿವಪುರಾಣಂ ಹಿ ಸಪ್ತಸಂಹಿತಮಾದರಾತ್।",
            "ಪರಿಪೂರ್ಣಂ ಪಠೇದ್ಯಸ್ತು ಸ ಜೀವನ್ಮುಕ್ತ ಉಚ್ಯತೇ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 36,
          "lines": [
            "ಪುಮಾನಜ್ಞಾನತಸ್ತಾವದ್ ಭ್ರಮತೇಽಸ್ಮಿನ್ಭವೇ ಮುನೇ।",
            "ಯಾವತ್ಕರ್ಣಗತಂ ನಾಸ್ತಿ ಪುರಾಣಂ ಶೈವಮುತ್ತಮಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 37,
          "lines": [
            "ಕಿಂ ಶ್ರುತೈರ್ಬಹುಭಿಃ ಶಾಸ್ತ್ರೈಃ ಪುರಾಣೈಶ್ಚ ಭ್ರಮಾವಹೈಃ।",
            "ಶೈವಂ ಪುರಾಣಮೇಕಂ ಹಿ ಮುಕ್ತಿದಾನೇನ ಗರ್ಜತಿ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 38,
          "lines": [
            "ಏತಚ್ಛಿವಪುರಾಣಸ್ಯ ಕಥಾ ಭವತಿ ಯದ್ಗೃಹೇ।",
            "ತೀರ್ಥಭೂತಂ ಹಿ ತದ್ಗೇಹಂ ವಸತಾಂ ಪಾಪನಾಶನಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 39,
          "lines": [
            "ಅಶ್ವಮೇಧಸಹಸ್ರಾಣಿ ವಾಜಪೇಯಶತಾನಿ ಚ।",
            "ಕಲಾಂ ಶಿವಪುರಾಣಸ್ಯ ನಾರ್ಹಂತಿ ಖಲು ಷೋಡಶೀಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 40,
          "lines": [
            "ತಾವತ್ ಸ ಪ್ರೋಚ್ಯತೇ ಪಾಪೀ ಪಾಪಕೃನ್ಮುನಿಸತ್ತಮ।",
            "ಯಾವತ್ ಶಿವಪುರಾಣಂ ಹಿ ನ ಶೃಣೋತಿ ಸುಭಕ್ತಿತಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 41,
          "lines": [
            "ಗಙ್ಗಾದ್ಯಾಃ ಪುಣ್ಯನದ್ಯಶ್ಚ ಸಪ್ತಪುರ್ಯೋ ಗಯಾ ತಥಾ।",
            "ಏತಚ್ಛಿವಪುರಾಣಸ್ಯ ಸಮತಾಂ ಯಾಂತಿ ನ ಕ್ವಚಿತ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 42,
          "lines": [
            "ನಿತ್ಯಂ ಶಿವಪುರಾಣಸ್ಯ ಶ್ಲೋಕಂ ಶ್ಲೋಕಾರ್ಧಮೇವ ಚ।",
            "ಸ್ವಮುಖೇನ ಪಠೇದ್ಭಕ್ತ್ಯಾ ಯದೀಚ್ಛೇತ್ ಪರಮಾಂ ಗತಿಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 43,
          "lines": [
            "ಏತಚ್ಛಿವಪುರಾಣಂ ಯೋ ವಾಚಯೇದರ್ಥತೋಽನಿಶಮ್।",
            "ಪಠೇದ್ವಾ ಪ್ರೀತಿತೋ ನಿತ್ಯಂ ಸ ಪುಣ್ಯಾತ್ಮಾ ನ ಸಂಶಯಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 44,
          "lines": [
            "ಅಂತಕಾಲೇ ಹಿ ಯಶ್ಚೈನಂ ಶೃಣುಯಾದ್ಭಕ್ತಿತಃ ಸುಧೀಃ।",
            "ಸುಪ್ರಸನ್ನೋ ಮಹೇಶಾನಸ್ತಸ್ಮೈ ಯಚ್ಛತಿ ಸ್ವಂ ಪದಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 45,
          "lines": [
            "ಏತಚ್ಛಿವಪುರಾಣಂ ಯಃ ಪೂಜಯೇನ್ನಿತ್ಯಮಾದರಾತ್।",
            "ಸ ಭುಕ್ತ್ವೇಹಾಖಿಲಾನ್ ಕಾಮಾನಂತೇ ಶಿವಪದಂ ಲಭೇ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 46,
          "lines": [
            "ಏತಚ್ಛಿವಪುರಾಣಸ್ಯ ಕುರ್ವನ್ನಿತ್ಯಮತಂದ್ರಿತಃ।",
            "ಪಟ್ಟವಸ್ತ್ರಾದಿನಾ ಸಮ್ಯಕ್ ಸತ್ಕಾರಂ ಸ ಸುಖೀ ಸದಾ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 47,
          "lines": [
            "ಶೈವಂ ಪುರಾಣಮಮಲಂ ಶೈವಸರ್ವಸ್ವಮಾದರಾತ್।",
            "ಸೇವನೀಯಂ ಪ್ರಯತ್ನೇನ ಪರತ್ರೇಹ ಸುಖೇಪ್ಸುನಾ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 48,
          "lines": [
            "ಚತುರ್ವರ್ಗಪ್ರದಂ ಶೈವಂ ಪುರಾಣಮಮಲಂ ಪರಮ್।",
            "ಶ್ರೋತವ್ಯಂ ಸರ್ವದಾ ಪ್ರೀತ್ಯಾ ಪಠಿತವ್ಯಂ ವಿಶೇಷತಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 49,
          "lines": [
            "ವೇದೇತಿಹಾಸಶಾಸ್ತ್ರೇಷು ಪರಂ ಶ್ರೇಯಸ್ಕರಂ ಮಹತ್।",
            "ಶೈವಂ ಪುರಾಣಂ ವಿಜ್ಞೇಯಂ ಸರ್ವಥಾ ಹಿ ಮುಮುಕ್ಷುಭಿಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 50,
          "lines": [
            "ಶೈವಂ ಪುರಾಣಮಿದಮಾತ್ಮವಿದಾಂ ವರಿಷ್ಠಂ",
            "ಸೇವ್ಯಂ ಸದಾ ಪರಮವಸ್ತು ಸತಾ ಸಮರ್ಚ್ಯಮ್।",
            "ತಾಪತ್ರಯಾಭಿಶಮನಂ ಸುಖದಂ ಸದೈವ",
            "ಪ್ರಾಣಪ್ರಿಯಂ ವಿಧಿಹರೀಶಮುಖಾಮರಾಣಾಮ್॥ ೫೦॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 51,
          "lines": [
            "ವಂದೇ ಶಿವಪುರಾಣಂ ಹಿ ಸರ್ವದಾ ಹಂ ಪ್ರಸನ್ನಧೀಃ।",
            "ಶಿವಃ ಪ್ರಸನ್ನತಾಂ ಯಾಯಾದ್ ದದ್ಯಾತ್ ಸ್ವಪದಯೋ ರತಿಮ್॥"
          ]
        }
      ]
    }
  ]
}
