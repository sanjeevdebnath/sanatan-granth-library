  "blocks": [
    {
      "speaker": "ಬ್ರಾಹ್ಮಣ ಉವಾಚ",
      "shlokas": [
        {
          "number": 1,
          "lines": [
            "ದಿಷ್ಟ್ಯಾ ಕಾಲೇ ಪ್ರಬುದ್ಧಾಸಿ ಶಿವಾನುಗ್ರಹತೋ ವರಾಮ್ ।",
            "ಇಮಾಂ ಶಿವಪುರಾಣಸ್ಯ ಶ್ರುತ್ವಾ ವೈರಾಗ್ಯವತ್ಕಥಾಮ್॥"
          ]
        },
        {
          "number": 2,
          "lines": [
            "ಮಾ ಭೈಷೀರ್ದ್ವಿಜಪತ್ನಿ ತ್ವಂ ಶಿವಸ್ಯ ಶರಣಂ ವ್ರಜ ।",
            "ಶಿವಾನುಗ್ರಹತಃ ಸರ್ವಂ ಪಾಪಂ ಸದ್ಯೋ ವಿನಶ್ಯತಿ॥"
          ]
        },
        {
          "number": 3,
          "lines": [
            "ವಕ್ಷ್ಯಾಮಿ ತೇ ಪರಂ ವಸ್ತು ಶಿವಕೀರ್ತಿಸಮನ್ವಿತಮ್ ।",
            "ಭವಿಷ್ಯತಿ ಗತಿರ್ಯೇನ ಸರ್ವದಾ ತೇ ಸುಖಾವಹಾ॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 4,
          "lines": [
            "ಸತ್ಕಥಾಶ್ರವಣಾದೇವ ಜಾತಾ ತೇ ಮತಿರೀದೃಶೀ ।",
            "ಪಶ್ಚಾತ್ತಾಪಾನ್ವಿತಾ ಶುದ್ಧಾ ವೈರಾಗ್ಯಂ ವಿಷಯೇಷು ಚ॥"
          ]
        },
        {
          "number": 5,
          "lines": [
            "ಪಶ್ಚಾತ್ತಾಪಃ ಪಾಪಕೃತಾಂ ಪಾಪಾನಾಂ ನಿಷ್ಕೃತಿಃ ಪರಾ ।",
            "ಸರ್ವೇಷಾಂ ವರ್ಣಿತಂ ಸದ್ಭಿಃ ಸರ್ವಪಾಪವಿಶೋಧನಮ್॥"
          ]
        },
        {
          "number": 6,
          "lines": [
            "ಪಶ್ಚಾತ್ತಾಪೇನೈವ ಶುದ್ಧಿಃ ಪ್ರಾಯಶ್ಚಿತ್ತಂ ಕರೋತಿ ಸಃ ।",
            "ಯಥೋಪದಿಷ್ಟಂ ಸದ್ಭಿರ್ಹಿ ಸರ್ವಪಾಪವಿಶೋಧನಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 7,
          "lines": [
            "ಪ್ರಾಯಶ್ಚಿತ್ತಮಧೀಕೃತ್ಯ ವಿಧಿವನ್ನಿರ್ಭಯಃ ಪುಮಾನ್ ।",
            "ಸ ಯಾತಿ ಸುಗತಿಂ ಪ್ರಾಯಃ ಪಶ್ಚಾತ್ತಾಪೀ ನ ಸಂಶಯಃ॥"
          ]
        },
        {
          "number": 8,
          "lines": [
            "ಏತಚ್ಛಿವಪುರಾಣಸ್ಯ ಕಥಾಶ್ರವಣತೋ ಯಥಾ ।",
            "ಜಾಯತೇ ಚಿತ್ತಶುದ್ಧಿರ್ಹಿ ನ ತಥಾನ್ಯೈರುಪಾಯತಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 9,
          "lines": [
            "ಶೋಧ್ಯಮಾನಂ ದರ್ಪಣಂ ಹಿ ಯಥಾ ಭವತಿ ನಿರ್ಮಲಮ್ ।",
            "ತಥೈತತ್ಕಥಯಾ ಚೇತೋ ವಿಶುದ್ಧಿಂ ಯಾತ್ಯಸಂಶಯಮ್॥"
          ]
        },
        {
          "number": 10,
          "lines": [
            "ವಿಶುದ್ಧೇ ಚೇತಸಿ ಶಿವೋ ನೃಣಾಂ ತಿಷ್ಠತಿ ಸಾಮ್ಬಿಕಃ ।",
            "ತತೋ ಯಾತಿ ವಿಶುದ್ಧಾತ್ಮಾ ಸಾಮ್ಬಶಮ್ಭೋಃ ಪರಂ ಪದಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 11,
          "lines": [
            "ಅತಃ ಸರ್ವಸ್ಯ ವರ್ಗಸ್ಯೈತತ್ಕಥಾಸಾಧನಂ ಮತಮ್ ।",
            "ಏತದರ್ಥಂ ಮಹಾದೇವೋ ನಿರ್ಮಮೇ ತ್ವಾಗ್ರಹಾದಿಮಾಮ್॥"
          ]
        },
        {
          "number": 12,
          "lines": [
            "ಕಥಯಾ ಸಿದ್ಧ್ಯತಿ ಧ್ಯಾನಮನಯಾ ಗಿರಿಜಾಪತೇಃ ।",
            "ಧ್ಯಾನಾಜ್ಜ್ಞಾನಂ ಪರಂ ತಸ್ಮಾತ್ಕೈವಲ್ಯಂ ಭವತಿ ಧ್ರುವಮ್॥"
          ]
        },
        {
          "number": 13,
          "lines": [
            "ಅಸಿದ್ಧಶಙ್ಕರಧ್ಯಾನಃ ಕಥಾಮೇವ ಶೃಣೋತಿ ಯಃ ।",
            "ಸ ಪ್ರಾಪ್ಯಾನ್ಯಭವೇ ಧ್ಯಾನಂ ಶಮ್ಭೋರ್ಯಾತಿ ಪರಾಂ ಗತಿಮ್॥"
          ]
        },
        {
          "number": 14,
          "lines": [
            "ಏತತ್ಕಥಾಶ್ರವಣತಃ ಕೃತ್ವಾ ಧ್ಯಾನಮುಮಾಪತೇಃ ।",
            "ತೇ ಪಶ್ಚಾತ್ತಾಪಿನಃ ಪಾಪಾ ಬಹವಃ ಸಿದ್ಧಿಮಾಗತಾಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 15,
          "lines": [
            "ಸರ್ವೇಷಾಂ ಶ್ರೇಯಸಾಂ ಬೀಜಂ ಸತ್ಕಥಾಶ್ರವಣಂ ನೃಣಾಮ್ ।",
            "ಯಥಾವರ್ತ್ಮಸಮಾರಾಧ್ಯಂ ಭವಬಂಧಗದಾಪಹಮ್॥"
          ]
        },
        {
          "number": 16,
          "lines": [
            "ಕಥಾಶ್ರವಣತಃ ಶಮ್ಭೋರ್ಮನನಾಚ್ಚ ತತೋ ಹೃದಾ ।",
            "ನಿದಿಧ್ಯಾಸನತಶ್ಚೈವ ಚಿತ್ತಶುದ್ಧಿರ್ಭವತ್ಯಲಮ್॥"
          ]
        },
        {
          "number": 17,
          "lines": [
            "ಅತೋ ಭಕ್ತಿರ್ಮಹೇಶಸ್ಯ ಪುತ್ರಾಭ್ಯಾಂ ಭವತಿ ಧ್ರುವಮ್ ।",
            "ತದನುಗ್ರಹತೋ ದಿವ್ಯಾ ತತೋ ಮುಕ್ತಿರ್ನ ಸಂಶಯಃ॥"
          ]
        },
        {
          "number": 18,
          "lines": [
            "ತದ್ವಿಹೀನಃ ಪಶುರ್ಜ್ಞೇಯೋ ಮಾಯಾಬಂಧನಸಕ್ತಧೀಃ ।",
            "ಸಂಸಾರಬಂಧನಾನ್ನೈವ ಮುಕ್ತೋ ಭವತಿ ಸ ಧ್ರುವಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 19,
          "lines": [
            "ಅತೋ ಹಿ ದ್ವಿಜಪತ್ನಿ ತ್ವಂ ವಿಷಯೇಭ್ಯೋ ನಿವೃತ್ತಧೀಃ ।",
            "ಶೃಣು ಶಮ್ಭೋಃ ಕಥಾಂ ಚೈತಾಂ ಭಕ್ತ್ಯಾ ಪರಮಪಾವನೀಮ್॥"
          ]
        },
        {
          "number": 20,
          "lines": [
            "ಶೃಣ್ವಂತ್ಯಾಃ ಸತ್ಕಥಾಮೇತಾಂ ಶಙ್ಕರಸ್ಯ ಪರಾತ್ಮನಃ ।",
            "ಶುದ್ಧಿಮೇಷ್ಯತಿ ಚೇತಸ್ತೇ ತತೋ ಮುಕ್ತಿಮವಾಪ್ಸ್ಯಸಿ॥"
          ]
        },
        {
          "number": 21,
          "lines": [
            "ಧ್ಯಾಯತಃ ಶಿವಪಾದಾಬ್ಜಂ ಚೇತಸಾ ನಿರ್ಮಲೇನ ವೈ ।",
            "ಏಕೇನ ಜನ್ಮನಾ ಮುಕ್ತಿಃ ಸತ್ಯಂ ಸತ್ಯಂ ವದಾಮ್ಯಹಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 22,
          "lines": [
            "ಇತ್ಯುಕ್ತ್ವಾ ಸ ದ್ವಿಜವರೋ ವರಃ ಶೈವಃ ಕೃಪಾರ್ದ್ರಧೀಃ ।",
            "ತೂಷ್ಣೀಂ ಬಭೂವ ಶುದ್ಧಾತ್ಮಾ ಶಿವಧ್ಯಾನಪರಾಯಣಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 23,
          "lines": [
            "ಅಥ ಬಿಂದುಗಪತ್ನೀ ಸಾ ಚಂಚುಲಾಹ್ವಾ ಪ್ರಸನ್ನಧೀಃ ।",
            "ಇತ್ಯುಕ್ತಾ ತೇನ ವಿಪ್ರೇಣ ಸಮಾಸೀದ್ಬಾಷ್ಪಲೋಚನಾ॥"
          ]
        },
        {
          "number": 24,
          "lines": [
            "ಪಪಾತಾರಂ ದ್ವಿಜೇಂದ್ರಸ್ಯ ಪಾದಯೋಸ್ತಸ್ಯ ಹೃಷ್ಟಧೀಃ ।",
            "ಚಂಚುಲಾ ಸಾಂಜಲಿಃ ಸಾ ಚ ಕೃತಾರ್ಥಾಸ್ಮೀತ್ಯಭಾಷತ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಚಂಚುಲೋವಾಚ",
      "shlokas": [
        {
          "number": 25,
          "lines": [
            "ಅಥ ಸೋತ್ಥಾಯ ಸಾತಙ್ಕಾ ಸಾಂಜಲಿರ್ಗದ್ಗದಾಕ್ಷರಮ್ ।",
            "ತಮುವಾಚ ಮಹಾಶೈವಂ ದ್ವಿಜಂ ವೈರಾಗ್ಯಯುಕ್ಸುಧೀಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 26,
          "lines": [
            "ಬ್ರಹ್ಮಞ್ಛೈವವರ ಸ್ವಾಮಿಂಧನ್ಯಸ್ತ್ವಂ ಪರಮಾರ್ಥದೃಕ್ ।",
            "ಪರೋಪಕಾರನಿರತೋ ವರ್ಣನೀಯಃ ಸುಸಾಧುಷು॥"
          ]
        },
        {
          "number": 27,
          "lines": [
            "ಉದ್ಧರೋದ್ಧರ ಮಾಂ ಸಾಧೋ ಪತಂತೀಂ ನರಕಾರ್ಣವೇ ।",
            "ಶ್ರುತ್ವಾ ಯಾಂ ಸುಕಥಾಂ ಶೈವೀಂ ಪುರಾಣಾರ್ಥವಿಜೃಮ್ಭಿತಾಮ್॥"
          ]
        },
        {
          "number": 28,
          "lines": [
            "ವಿರಕ್ತಧೀರಹಂ ಜಾತಾ ವಿಷಯೇಭ್ಯಶ್ಚ ಸರ್ವತಃ ।",
            "ಸುಶ್ರದ್ಧಾ ಮಹತೀ ಹ್ಯೇತತ್ಪುರಾಣಶ್ರವಣೇಽಧುನಾ॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 29,
          "lines": [
            "ಇತ್ಯುಕ್ತ್ವಾ ಸಾಂಜಲಿಃ ಸಾ ವೈ ಸಮ್ಪ್ರಾಪ್ಯ ತದನುಗ್ರಹಮ್ ।",
            "ತತ್ಪುರಾಣಂ ಶ್ರೋತುಕಾಮಾಽತಿಷ್ಠತ್ತತ್ಸೇವನೇ ರತಾ॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 30,
          "lines": [
            "ಅಥ ಶೈವವರೋ ವಿಪ್ರಸ್ತಸ್ಮಿನ್ನೇವ ಸ್ಥಲೇ ಸುಧೀಃ ।",
            "ಸತ್ಕಥಾಂ ಶ್ರಾವಯಾಮಾಸ ತತ್ಪುರಾಣಸ್ಯ ತಾಂ ಸ್ತ್ರಿಯಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 31,
          "lines": [
            "ಇತ್ಥಂ ತಸ್ಮಿನ್ಮಹಾಕ್ಷೇತ್ರೇ ತಸ್ಮಾದೇವ ದ್ವಿಜೋತ್ತಮಾತ್ ।",
            "ಕಥಾಂ ಶಿವಪುರಾಣಸ್ಯ ಸಾ ಶುಶ್ರಾವ ಮಹೋತ್ತಮಾಮ್॥"
          ]
        },
        {
          "number": 32,
          "lines": [
            "ಭಕ್ತಿಜ್ಞಾನವಿರಾಗಾಣಾಂ ವರ್ದ್ಧಿನೀಂ ಮುಕ್ತಿದಾಯಿನೀಮ್ ।",
            "ಬಭೂವ ಸುಕೃತಾರ್ಥಾ ಸಾ ಶ್ರುತ್ವಾ ತಾಂ ಸತ್ಕಥಾಂ ಪರಾಮ್॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 33,
          "lines": [
            "ಸದ್ಗುರೋಸ್ತಸ್ಯ ಕೃಪಯಾ ಶುದ್ಧಚಿತ್ತಾ ಚ ಸಾ ದ್ರುತಮ್ ।",
            "ಶಿವಾನುಗ್ರಹತಃ ಶಮ್ಭೋಃ ರೂಪಧ್ಯಾನಮವಾಪ ಹ॥"
          ]
        },
        {
          "number": 34,
          "lines": [
            "ಇತ್ಥಂ ಸದ್ಗುರುಮಾಶ್ರಿತ್ಯ ಸಾ ಪ್ರಾಪ್ತಶಿವಸನ್ಮತಿಃ ।",
            "ದಧ್ಯೌ ಮುಹುರ್ಮುಹುಃ ಶಮ್ಭೋಶ್ಚಿದಾನಂದಮಯಂ ವಪುಃ॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 35,
          "lines": [
            "ಸ್ನಾತ್ವಾ ತೀರ್ಥಜಲೇ ನಿತ್ಯಂ ಜಟಾವಲ್ಕಲಧಾರಿಣೀ ।",
            "ಭಸ್ಮೋದ್ಧೂಲಿತಸರ್ವಾಙ್ಗೀ ರುದ್ರಾಕ್ಷಕೃತಭೂಷಣಾ॥"
          ]
        },
        {
          "number": 36,
          "lines": [
            "ಶಿವನಾಮಜಪಾಸಕ್ತಾ ವಾಗ್ಯತಾ ಮಿತಭೋಜನಾ ।",
            "ಗುರೂಪದಿಷ್ಟಮಾರ್ಗೇಣ ಸಾ ಶಿವಂ ಸಮತೋಷಯತ್॥"
          ]
        },
        {
          "number": 37,
          "lines": [
            "ಏವಂ ತಸ್ಯಾಶ್ಚಂಚುಲಾಯಾಃ ಕುರ್ವಂತ್ಯಾ ಧ್ಯಾನಮುತ್ತಮಮ್ ।",
            "ಬಹುಕಾಲೋ ವ್ಯತೀಯಾಯ ಶಮ್ಭೋಸ್ತತ್ರೈವ ಶೌನಕ॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 38,
          "lines": [
            "ಅಥ ಕಾಲೇನ ಪೂರ್ಣೇನ ಭಕ್ತಿತ್ರಿಕಸಮನ್ವಿತಾ ।",
            "ಸಮುತ್ಸಸರ್ಜ ದೇಹಂ ಸ್ವಮನಾಯಾಸೇನ ಚಂಚುಲಾ॥"
          ]
        }
      ]
    },
    {
      "speaker": "",
      "shlokas": [
        {
          "number": 39,
          "lines": [
            "ವಿಮಾನಂ ದ್ರುತಮಾಯಾಂತಂ ಪ್ರೇಷಿತಂ ತ್ರಿಪುರಾರಿಣಾ ।",
            "ದಿವ್ಯಂ ಸ್ವಗಣಸಂಯುಕ್ತಂ ನಾನಾಶೋಭಾಸಮನ್ವಿತಮ್॥"
          ]
        },
        {
          "number": 40,
          "lines": [
            "ಅಥ ತತ್ರ ಸಮಾರೂಢಾ ಮಹೇಶಾನುಚರೈರ್ವರೈಃ ।",
