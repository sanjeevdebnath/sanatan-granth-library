  "section": "ಮಾಹಾತ್ಮ್ಯ",
  "chapter": 5,
  "title": "ಬಿಂದುಗನ ಸದ್ಗತಿವರ್ಣನೆ",
  "source": {
    "language": "kn",
    "edition": "User-provided scanned Kannada Shiva Purana",
    "status": "Kannada-script shlokas prepared from the repository Sanskrit text; Kannada meanings to be transcribed from the scanned edition",
    "printedPages": "see scanned Kannada edition",
    "verseRange": "1-60"
  },
  "blocks": [
    {
      "speaker": "ಶೌನಕ ಉವಾಚ",
      "shlokas": [
        {
          "number": 1,
          "lines": [
            "ಸೂತ ಸೂತ ಮಹಾಭಾಗ ಧನ್ಯಸ್ತ್ವಂ ಶಿವಸಕ್ತಧೀಃ।",
            "ಶ್ರಾವಿತೇಯಂ ಕಥಾಸ್ಮಾಕಮದ್ಭುತಾ ಭಕ್ತಿವರ್ಧಿನೀ॥ ೧॥"
          ]
        },
        {
          "number": 2,
          "lines": [
            "ತತ್ರ ಗತ್ವಾ ಕಿಂ ಚಕಾರ ಚಞ್ಚುಲಾ ಪ್ರಾಪ್ತಸದ್ಗತಿಃ।",
            "ತತ್ ತ್ವಂ ವದ ವಿಶೇಷೇಣ ತತ್ಪತೇಶ್ಚ ಮಹಾಮತೇ॥ ೨॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 3,
          "lines": [
            "ಸಾ ಕದಾಚಿದುಮಾಂ ದೇವೀಮುಪಗಮ್ಯ ಪ್ರಣಮ್ಯ ಚ।",
            "ಸುತುಷ್ಟಾವ ಕರೌ ಬದ್ಧ್ವಾ ಪರಮಾನಂದಸಮ್ಪ್ಲುತಾ॥ ೩॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಚಞ್ಚುಲೋವಾಚ",
      "shlokas": [
        {
          "number": 4,
          "lines": [
            "ಗಿರಿಜೇ ಸ್ಕಂದಮಾತಸ್ತ್ವಂ ಸೇವಿತಾ ಸರ್ವದಾ ನರೈಃ।",
            "ಸರ್ವಸೌಖ್ಯಪ್ರದೇ ಶಮ್ಭುಪ್ರಿಯೇ ಬ್ರಹ್ಮಸ್ವರೂಪಿಣಿ॥ ೪॥"
          ]
        },
        {
          "number": 5,
          "lines": [
            "ವಿಷ್ಣುಬ್ರಹ್ಮಾದಿಭಿಸ್ಸೇವ್ಯಾಽ ಸಗುಣಾ ನಿರ್ಗುಣಾಪಿ ಚ।",
            "ತ್ವಮಾದ್ಯಾ ಪ್ರಕೃತಿಸ್ಸೂಕ್ಷ್ಮಾ ಸಚ್ಚಿದಾನಂದರೂಪಿಣೀ॥ ೫॥"
          ]
        },
        {
          "number": 6,
          "lines": [
            "ಸೃಷ್ಟಿಸ್ಥಿತಿಲಯಕರೀ ತ್ರಿಗುಣಾ ತ್ರಿಸುರಾಲಯಾ।",
            "ಬ್ರಹ್ಮವಿಷ್ಣುಮಹೇಶಾನಾಂ ಸುಪ್ರತಿಷ್ಠಾಕರಾ ಪರಾ॥ ೬॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 7,
          "lines": [
            "ಇತಿ ಸ್ತುತ್ವಾ ಮಹೇಶೀಂ ತಾಂ ಚಞ್ಚುಲಾ ಪ್ರಾಪ್ತಸದ್ಗತಿಃ।",
            "ವಿರರಾಮ ನತಸ್ಕಂಧಾ ಪ್ರೇಮಪೂರ್ಣಾಶ್ರುಲೋಚನಾ॥ ೭॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 8,
          "lines": [
            "ತತಃ ಸಾ ಕರುಣಾವಿಷ್ಟಾ ಪಾರ್ವತೀ ಶಙ್ಕರಪ್ರಿಯಾ।",
            "ತಾಮುವಾಚ ಮಹಾಪ್ರೀತ್ಯಾ ಚಞ್ಚುಲಾಂ ಭಕ್ತವತ್ಸಲಾ॥ ೮॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಪಾರ್ವತ್ಯುವಾಚ",
      "shlokas": [
        {
          "number": 9,
          "lines": [
            "ಚಞ್ಚುಲೇ ಸಖಿ ಸುಪ್ರೀತಾನಯಾ ಸ್ತುತ್ಯಾಸ್ಮಿ ಸುಂದರಿ।",
            "ಕಿಂ ಯಾಚಸೇ ವರಂ ಬ್ರೂಹಿ ನಾದೇಯಂ ವಿದ್ಯತೇ ತವ॥ ೯॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 10,
          "lines": [
            "ಇತ್ಯುಕ್ತಾ ಸಾ ಗಿರಿಜಯಾ ಚಞ್ಚುಲಾ ಸುಪ್ರಣಮ್ಯ ತಾಮ್।",
            "ಪರ್ಯಪೃಚ್ಛತ್ ಸುಪ್ರೀತ್ಯಾ ಸಾಞ್ಜಲಿರ್ನತಮಸ್ತಕಾ॥ ೧೦॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಚಞ್ಚುಲೋವಾಚ",
      "shlokas": [
        {
          "number": 11,
          "lines": [
            "ಮಮ ಭರ್ತಾಧುನಾ ಕ್ವಾಸ್ತೇ ನೈವ ಜಾನಾಮಿ ತದ್ಗತಿಮ್।",
            "ತೇನ ಯುಕ್ತಾ ಯಥಾಹಂ ವೈ ಭವಾಮಿ ಗಿರಿಜೇಽನಘೇ॥ ೧೧॥"
          ]
        },
        {
          "number": 12,
          "lines": [
            "ತಥೈವ ಕುರು ಕಲ್ಯಾಣಿ ಕೃಪಯಾ ದೀನವತ್ಸಲೇ।",
            "ಮಹಾದೇವಿ ಮಹೇಶಾನಿ ಭರ್ತಾ ಮೇ ವೃಷಲೀಪತಿಃ। ಮತ್ತಃ ಪೂರ್ವಂ ಮೃತಃ ಪಾಪೀ ನ ಜಾನೇ ಕಾಂ ಗತಿಂ ಗತಃ॥ ೧೨॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 13,
          "lines": [
            "ಇತ್ಯಾಕರ್ಣ್ಯ ವಚಸ್ತಸ್ಯಾಶ್ಚಞ್ಚುಲಾಯಾ ಹಿ ಪಾರ್ವತೀ।",
            "ಪ್ರತ್ಯುವಾಚ ಸುಸಮ್ಪ್ರೀತ್ಯಾ ಗಿರಿಜಾ ನಯವತ್ಸಲಾ॥ ೧೩॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಗಿರಿಜೋವಾಚ",
      "shlokas": [
        {
          "number": 14,
          "lines": [
            "ಸುತೇ ಭರ್ತಾ ಬಿಂದುಗಾಹ್ವೋ ಮಹಾಪಾಪೀ ದುರಾಶಯಃ।",
            "ವೇಶ್ಯಾಭೋಗೀ ಮಹಾಮೂಢೋ ಮೃತ್ವಾ ಸ ನರಕಂ ಗತಃ॥ ೧೪॥"
          ]
        },
        {
          "number": 15,
          "lines": [
            "ಭುಕ್ತ್ವಾ ನರಕದುಃಖಾನಿ ವಿವಿಧಾನ್ಯಮಿತಾಃ ಸಮಾಃ।",
            "ಪಾಪಶೇಷೇಣ ಪಾಪಾತ್ಮಾ ವಿಂಧ್ಯೇ ಜಾತಃ ಪಿಶಾಚಕಃ॥ ೧೫॥"
          ]
        },
        {
          "number": 16,
          "lines": [
            "ಇದಾನೀಂ ಸ ಪಿಶಾಚೋಽಸ್ತಿ ನಾನಾಕ್ಲೇಶಸಮನ್ವಿತಃ।",
            "ತತ್ರೈವ ವಾತಭುಗ್ದುಷ್ಟಃ ಸರ್ವಕಷ್ಟವಹಃ ಸದಾ॥ ೧೬॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 17,
          "lines": [
            "ಇತಿ ಗೌರ್ಯಾ ವಚಃ ಶ್ರುತ್ವಾ ಚಞ್ಚುಲಾ ಸಾ ಶುಭವ್ರತಾ।",
            "ಪತಿದುಃಖೇನ ಮಹತಾ ದುಃಖಿತಾಸೀತ್ತದಾ ಕಿಲ॥ ೧೭॥"
          ]
        },
        {
          "number": 18,
          "lines": [
            "ಸಮಾಧಾಯ ತತಶ್ಚಿತ್ತಂ ಸುಪ್ರಣಮ್ಯ ಮಹೇಶ್ವರೀಮ್।",
            "ಪುನಃ ಪಪ್ರಚ್ಛ ಸಾ ನಾರೀ ಹೃದಯೇನ ವಿದೂಯತಾ॥ ೧೮॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಚಞ್ಚುಲೋವಾಚ",
      "shlokas": [
        {
          "number": 19,
          "lines": [
            "ಮಹೇಶ್ವರಿ ಮಹಾದೇವಿ ಕೃಪಾಂ ಕುರು ಮಮೋಪರಿ।",
            "ಸಮುದ್ಧರ ಪತಿಂ ಮೇಽದ್ಯ ದುಷ್ಟಕರ್ಮಕರಂ ಖಲಮ್॥ ೧೯॥"
          ]
        },
        {
          "number": 20,
          "lines": [
            "ಕೇನೋಪಾಯೇನ ಮೇ ಭರ್ತಾ ಪಾಪಾತ್ಮಾ ಸ ಕುಬುದ್ಧಿಮಾನ್।",
            "ಸದ್ಗತಿಂ ಪ್ರಾಪ್ನುಯಾದ್ದೇವಿ ತದ್ವದಾಶು ನಮೋಽಸ್ತು ತೇ॥ ೨೦॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 21,
          "lines": [
            "ಇತ್ಯಾಕರ್ಣ್ಯ ವಚಸ್ತಸ್ಯಾಃ ಪಾರ್ವತೀ ಭಕ್ತವತ್ಸಲಾ।",
            "ಪ್ರತ್ಯುವಾಚ ಪ್ರಸನ್ನಾತ್ಮಾ ಚಞ್ಚುಲಾಂ ಸ್ವಸಖೀಂ ಚ ತಾಮ್॥ ೨೧॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಪಾರ್ವತ್ಯುವಾಚ",
      "shlokas": [
        {
          "number": 22,
          "lines": [
            "ಶೃಣುಯಾದ್ಯದಿ ತೇ ಭರ್ತಾ ಪುಣ್ಯಾಂ ಶಿವಕಥಾಂ ಪರಾಮ್।",
            "ನಿಸ್ತೀರ್ಯ ದುರ್ಗತಿಂ ಸರ್ವಾಂ ಸದ್ಗತಿಂ ಪ್ರಾಪ್ನುಯಾದಿತಿ॥ ೨೨॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 23,
          "lines": [
            "ಇತಿ ಗೌರ್ಯಾ ವಚಃ ಶ್ರುತ್ವಾಮೃತಾಕ್ಷರಮಥಾದರಾತ್।",
            "ಕೃತಾಞ್ಜಲಿರ್ನತಸ್ಕಂಧಾ ಪ್ರಣನಾಮ ಪುನಃ ಪುನಃ॥ ೨೩॥"
          ]
        },
        {
          "number": 24,
          "lines": [
            "ತತ್ಕಥಾಶ್ರವಣಂ ಭರ್ತುಃ ಸರ್ವಪಾಪವಿಶುದ್ಧಯೇ।",
            "ಸದ್ಗತಿಪ್ರಾಪ್ತಯೇ ಚೈವ ಪ್ರಾರ್ಥಯಾಮಾಸ ತಾಂ ತದಾ॥ ೨೪॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಸೂತ ಉವಾಚ",
      "shlokas": [
        {
          "number": 25,
          "lines": [
            "ತಯಾ ಮುಹುರ್ಮುಹುರ್ನಾರ್ಯಾ ಪ್ರಾರ್ಥ್ಯಮಾನಾ ಶಿವಪ್ರಿಯಾ।",
            "ಗೌರೀ ಕೃಪಾನ್ವಿತಾಸೀತ್ ಸಾ ಮಹೇಶೀ ಭಕ್ತವತ್ಸಲಾ॥ ೨೫॥"
          ]
        },
        {
          "number": 26,
          "lines": [
            "ಅಥ ತುಮ್ಬುರುಮಾಹೂಯ ಶಿವಸತ್ಕೀರ್ತಿಗಾಯಕಮ್।",
            "ಪ್ರೀತ್ಯಾ ಗಂಧರ್ವರಾಜಂ ಹಿ ಗಿರಿಕನ್ಯೇದಮಬ್ರವೀತ್॥ ೨೬॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಗಿರಿಜೋವಾಚ",
      "shlokas": [
        {
          "number": 27,
          "lines": [
            "ಹೇ ತುಮ್ಬುರೋ ಶಿವಪ್ರೀತ ಮಮ ಮಾನಸಕಾರಕ।",
            "ಸಹಾನಯಾ ವಿಂಧ್ಯಶೈಲಂ ಭದ್ರಂ ತೇ ಗಚ್ಛ ಸತ್ವರಮ್॥ ೨೭॥"
          ]
        },
        {
          "number": 28,
          "lines": [
            "ಆಸ್ತೇ ತತ್ರ ಮಹಾಘೋರಃ ಪಿಶಾಚೋಽತಿಭಯಙ್ಕರಃ।",
            "ತದ್ವೃತ್ತಂ ಶೃಣು ಸುಪ್ರೀತ್ಯಾದಿತಃ ಸರ್ವಂ ಬ್ರವೀಮಿ ತೇ॥ ೨೮॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಗಿರಿಜೋವಾಚ",
      "shlokas": [
        {
          "number": 29,
          "lines": [
            "ಪುರಾಭವೇ ಪಿಶಾಚಃ ಸ ಬಿಂದುಗಾಹ್ವೋಽಭವದ್ ದ್ವಿಜಃ।",
            "ಅಸ್ಯಾ ನಾರ್ಯಾಃ ಪತಿರ್ದುಷ್ಟೋ ಮತ್ಸಖ್ಯಾ ವೃಷಲೀಪತಿಃ॥ ೨೯॥"
          ]
        },
        {
          "number": 30,
          "lines": [
            "ಸ್ನಾನಸಂಧ್ಯಾಕ್ರಿಯಾಹೀನೋಽಶೌಚಃ ಕ್ರೋಧವಿಮೂಢಧೀಃ।",
            "ದುರ್ಭಕ್ಷೀ ಸಜ್ಜನದ್ವೇಷೀ ದುಷ್ಪರಿಗ್ರಹಕಾರಕಃ॥ ೩೦॥"
          ]
        },
        {
          "number": 31,
          "lines": [
            "ಹಿಂಸಕಃ ಶಸ್ತ್ರಧಾರೀ ಚ ಸವ್ಯಹಸ್ತೇನ ಭೋಜನೀ।",
            "ದೀನಾನಾಂ ಪೀಡಕಃ ಕ್ರೂರಃ ಪರವೇಶ್ಮಪ್ರದೀಪಕಃ॥ ೩೧॥"
          ]
        },
        {
          "number": 32,
          "lines": [
            "ಚಾಣ್ಡಾಲಾಭಿರತೋ ನಿತ್ಯಂ ವೇಶ್ಯಾಭೋಗೀ ಮಹಾಖಲಃ।",
            "ಸ್ವಪತ್ನೀತ್ಯಾಗಕೃತ್ ಪಾಪೀ ದುಷ್ಟಸಙ್ಗರತಸ್ತದಾ॥ ೩೨॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಗಿರಿಜೋವಾಚ",
      "shlokas": [
        {
          "number": 33,
          "lines": [
            "ತೇನ ವೇಶ್ಯಾಕುಸಙ್ಗೇನ ಸುಕೃತಂ ನಾಶಿತಂ ಮಹತ್।",
            "ವಿತ್ತಲೋಭೇನ ಮಹಿಷೀ ನಿರ್ಭಯಾ ಜಾರಿಣೀ ಕೃತಾ॥ ೩೩॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಗಿರಿಜೋವಾಚ",
      "shlokas": [
        {
          "number": 34,
          "lines": [
            "ಆಮೃತ್ಯೋಃ ಸ ದುರಾಚಾರೀ ಕಾಲೇನ ನಿಧನಂ ಗತಃ।",
            "ಯಯೌ ಯಮಪುರಂ ಘೋರಂ ಭೋಗಸ್ಥಾನಂ ಹಿ ಪಾಪಿನಾಮ್॥ ೩೪॥"
          ]
        },
        {
          "number": 35,
          "lines": [
            "ತತ್ರ ಭುಕ್ತ್ವಾ ಸ ದುಷ್ಟಾತ್ಮಾ ನರಕಾನಿ ಬಹೂನಿ ಚ।",
            "ಇದಾನೀಂ ಸ ಪಿಶಾಚೋಽಸ್ತಿ ವಿಂಧ್ಯೇಽದ್ರೌ ಪಾಪಭುಕ್ ಖಲಃ॥ ೩೫॥"
          ]
        }
      ]
    },
    {
      "speaker": "ಗಿರಿಜೋವಾಚ",
      "shlokas": [
        {
          "number": 36,
          "lines": [
            "ತಸ್ಯಾಗ್ರೇ ಪರಮಾಂ ಪುಣ್ಯಾಂ ಸರ್ವಪಾಪವಿನಾಶಿನೀಮ್।",
            "ದಿವ್ಯಾಂ ಶಿವಪುರಾಣಸ್ಯ ಕಥಾಂ ಕಥಯ ಯತ್ನತಃ॥ ೩೬॥"
          ]
        },
        {
          "number": 37,
          "lines": [
            "ದ್ರುತಂ ಶಿವಪುರಾಣಸ್ಯ ಕಥಾಶ್ರವಣತಃ ಪರಾತ್।",
